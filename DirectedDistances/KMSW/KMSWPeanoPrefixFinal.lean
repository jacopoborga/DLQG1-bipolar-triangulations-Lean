module

public import DirectedDistances.KMSW.KMSWPeanoPrefix
public import DirectedDistances.PlanarMap.BipolarBoundaryBaseIsoOfRot
public import DirectedDistances.KMSW.KMSWForwardClass
public import DirectedDistances.KMSW.KMSWInverseClass
public import DirectedDistances.KMSW.FiniteWalkClassCarrier
public import DirectedDistances.PlanarMap.KMSWMapIsoClass

/-! # Final Peano prefix helper

`KMSWPeanoPrefixEmbedding` is a separate open step. -/

public section
namespace DirectedDistances.KMSW

open DirectedDistances.PlanarMap

variable {ℓ r n : ℕ}

/-- The inverse representative has a positive number of edges, so its
finite-walk class is in the base-carrier domain. Helper toward `thm-kmsw`
the paper result. -/
theorem kmswPeanoPrefixFinal_pos (R : KMSWMapRep ℓ r n) : 1 ≤ n := by
  have h := contour_numEdges_pos R.B
  rw [R.edges] at h
  omega

/-- The final stage index is in the dart-equivalence range for the inverse
representative. Helper toward `thm-kmsw`
the paper result. -/
theorem kmswPeanoPrefixFinal_lt (R : KMSWMapRep ℓ r n) :
    n - 1 < R.B.map.toCombinatorialMap.numEdges := by
  rw [R.edges]
  have h := contour_numEdges_pos R.B
  rw [R.edges] at h
  omega

/-- Every dart of the final stage generated by the inverse walk class of `R` -/
theorem kmswPeanoPrefixFinal_complete (R : KMSWMapRep ℓ r n) :
    ∀ d : StageDart
        (kmswStage (codeExtend (kmswRepInverseWalkClass R)) (n - 1)).nextEdge,
      (kmswStage (codeExtend (kmswRepInverseWalkClass R)) (n - 1)).present
        d.1.val = true := by
  have hn : 1 ≤ n := by
    have h := contour_numEdges_pos R.B
    rw [R.edges] at h
    omega
  intro d
  have h := kmswWalkClassBase_noMissingDarts hn
    (kmswRepInverseWalkClass R) d
  change ¬ (kmswStage (codeExtend (kmswRepInverseWalkClass R)) (n - 1)).present
    d.1.val = false at h
  cases hp : (kmswStage (codeExtend (kmswRepInverseWalkClass R)) (n - 1)).present
      d.1.val <;> simp_all

/-- The final stage index plus one is the number of edges of `R.B`. Helper -/
theorem kmswPeanoPrefixFinal_hfinal (R : KMSWMapRep ℓ r n) :
    (n - 1) + 1 = R.B.map.toCombinatorialMap.numEdges := by
  have hn : 0 < n := by
    have h := contour_numEdges_pos R.B
    rw [R.edges] at h
    exact h
  rw [R.edges]
  omega

/-- The root of the final inverse walk stage is the last dart of its left
boundary path. Helper toward `thm-kmsw`
the paper result. -/
theorem kmswPeanoPrefixFinal_stageRoot_eq_lastLeft (R : KMSWMapRep ℓ r n) :
    (kmswRootedStage (codeExtend (kmswRepInverseWalkClass R)) (n - 1)).root =
      pathLastDart
        (kmswWalkClassBase (kmswPeanoPrefixFinal_pos R)
          (kmswRepInverseWalkClass R)).leftPath
        (Nat.zero_lt_of_lt
          (kmswWalkClassBase (kmswPeanoPrefixFinal_pos R)
            (kmswRepInverseWalkClass R)).left_length_pos) := by
  let c := kmswRepInverseWalkClass R
  let B := kmswWalkClassBase (kmswPeanoPrefixFinal_pos R) c
  have hpath : B.leftPath.darts = kmswStageULDartRun (codeExtend c) (n - 1) := by
    change (Classical.choose (kmswWalkClassBase_paths
      (kmswPeanoPrefixFinal_pos R) c)).darts = _
    exact (Classical.choose_spec (Classical.choose_spec
      (kmswWalkClassBase_paths (kmswPeanoPrefixFinal_pos R) c))).1
  have hroot := kmswRootedStage_root_getLast_ULDartRun (codeExtend c) (n - 1)
  rw [← hpath] at hroot
  have hne : B.leftPath.darts ≠ [] := by
    intro hnil
    have hlen := B.leftPath.darts_length
    rw [hnil] at hlen
    simp at hlen
    have hpos := B.left_length_pos
    omega
  have hlast : B.leftPath.darts.getLast hne =
      (kmswRootedStage (codeExtend c) (n - 1)).root := by
    rw [List.getLast?_eq_getLast_of_ne_nil hne] at hroot
    exact Option.some.inj hroot
  have hpathLast : pathLastDart B.leftPath
      (Nat.zero_lt_of_lt B.left_length_pos) = B.leftPath.darts.getLast hne := by
    simp [pathLastDart, List.getLast_eq_getElem, B.leftPath.darts_length]
  dsimp [B, c]
  exact hlast.symm.trans hpathLast.symm

/-- A final prefix embedding identifies the inverse-walk carrier with the
representative carrier. Helper toward `thm-kmsw`
the paper result. -/
theorem kmswPeanoPrefixFinal_baseIso (R : KMSWMapRep ℓ r n)
    (P : KMSWPeanoPrefixEmbedding R.B (kmswRepInverseWalkClass R)
      (n - 1) (kmswPeanoPrefixFinal_lt R)) :
    Nonempty (BipolarBoundaryBaseIso
      (kmswWalkClassBase (kmswPeanoPrefixFinal_pos R)
        (kmswRepInverseWalkClass R)) R.B) := by
  let c := kmswRepInverseWalkClass R
  let B := kmswWalkClassBase (kmswPeanoPrefixFinal_pos R) c
  have hj := kmswPeanoPrefixFinal_lt R
  have hfinal := kmswPeanoPrefixFinal_hfinal R
  have hcomplete := kmswPeanoPrefixFinal_complete R
  let E := kmswPeanoPrefixEmbedding_finalDartEquiv R.B c (n - 1) hj P
    hfinal hcomplete
  have hrootStage :
      (kmswRootedStage (codeExtend c) (n - 1)).root =
        pathLastDart B.leftPath (Nat.zero_lt_of_lt B.left_length_pos) := by
    simpa only [B, c] using kmswPeanoPrefixFinal_stageRoot_eq_lastLeft R
  have hindex :
      (⟨n - 1, hj⟩ : Fin R.B.map.toCombinatorialMap.numEdges) =
        ⟨R.B.map.toCombinatorialMap.numEdges - 1, by
          have h := contour_numEdges_pos R.B
          omega⟩ := by
    apply Fin.ext
    change n - 1 = R.B.map.toCombinatorialMap.numEdges - 1
    rw [R.edges]
  refine ⟨bipolarBoundaryBaseIsoOfRotOfLastLeft B R.B E.dartEquiv ?_ ?_ ?_ ?_⟩
  · intro d
    change E.dartEquiv ((kmswRootedStage (codeExtend c) (n - 1)).map.rot d) =
      R.B.map.toCombinatorialMap.rot (E.dartEquiv d)
    exact E.rot_comm d
  · intro d
    change E.dartEquiv
        ((kmswRootedStage (codeExtend c) (n - 1)).map.toCombinatorialMap.edgeInv d) =
        R.B.map.toCombinatorialMap.edgeInv (E.dartEquiv d)
    exact E.edgeInv_comm d
  · intro d
    change R.B.map.tail (E.dartEquiv d) ↔
      (kmswRootedStage (codeExtend c) (n - 1)).map.tail d
    exact (E.tail_iff d).symm
  · calc
      E.dartEquiv (pathLastDart B.leftPath (Nat.zero_lt_of_lt B.left_length_pos)) =
          E.dartEquiv ((kmswRootedStage (codeExtend c) (n - 1)).root) :=
        congrArg E.dartEquiv hrootStage.symm
      _ = peanoEdge R.B ⟨n - 1, hj⟩ := E.root_comm
      _ = peanoEdge R.B
          ⟨R.B.map.toCombinatorialMap.numEdges - 1, by
            have h := contour_numEdges_pos R.B
            omega⟩ := congrArg (peanoEdge R.B) hindex
      _ = pathLastDart R.B.leftPath
          (Nat.zero_lt_of_lt R.B.left_length_pos) := peanoEdge_last R.B

/-- Applying the walk-class-to-map-class helper after the class-level inverse
recovers `[R]`, given the final prefix embedding. The induction producing that
embedding is a separate open step. Helper toward `thm-kmsw`
the paper result. -/
theorem kmswToMapIsoClass_inverse_of_finalPrefix (R : KMSWMapRep ℓ r n)
    (P : KMSWPeanoPrefixEmbedding R.B (kmswRepInverseWalkClass R)
      (n - 1) (kmswPeanoPrefixFinal_lt R)) :
    kmswToMapIsoClass (kmswPeanoPrefixFinal_pos R)
      (kmswClassInverseWalkClass (KMSWMapIsoClass.mk R)) =
        KMSWMapIsoClass.mk R := by
  unfold kmswToMapIsoClass
  rw [kmswClassInverseWalkClass_mk]
  change KMSWMapIsoClass.mk
      (KMSWMapRep.ofBase
        (kmswWalkClassBase (kmswPeanoPrefixFinal_pos R)
          (kmswRepInverseWalkClass R))
        (kmswWalkClassBase_numEdges (kmswPeanoPrefixFinal_pos R)
          (kmswRepInverseWalkClass R))) =
    KMSWMapIsoClass.mk R
  have hstage :
      KMSWMapIsoClass.mk
          (KMSWMapRep.ofBase
            (kmswWalkClassBase (kmswPeanoPrefixFinal_pos R)
              (kmswRepInverseWalkClass R))
            (kmswWalkClassBase_numEdges (kmswPeanoPrefixFinal_pos R)
              (kmswRepInverseWalkClass R))) =
        KMSWMapIsoClass.mk (KMSWMapRep.ofBase R.B R.edges) := by
    exact (KMSWMapRep.mk_ofBase_eq_iff
      (kmswWalkClassBase (kmswPeanoPrefixFinal_pos R)
        (kmswRepInverseWalkClass R))
      (kmswWalkClassBase_numEdges (kmswPeanoPrefixFinal_pos R)
        (kmswRepInverseWalkClass R)) R.B R.edges).2
      (kmswPeanoPrefixFinal_baseIso R P)
  have hrepresentative :
      KMSWMapIsoClass.mk (KMSWMapRep.ofBase R.B R.edges) =
        KMSWMapIsoClass.mk R := by
    apply Quotient.sound
    exact ⟨(R.B.transportIso
      (Fintype.equivFin (Fin R.dartCount))).symm⟩
  exact hstage.trans hrepresentative

end DirectedDistances.KMSW
