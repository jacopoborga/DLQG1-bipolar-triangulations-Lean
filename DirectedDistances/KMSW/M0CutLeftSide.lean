public section
namespace DirectedDistances.KMSW
open DirectedDistances.PlanarMap

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
This is the rotation-system (face-orbit) side of the cut. One may follow a
face or cross an edge outside the seam. The complementary-component face
correspondence in a plane drawing is separate.
Orientation evidence: `PlanarMap.PLDrawing.rotation_agreement` uses
`PlanarMap.CcwSuccessor`, and `PlanarMap.PLDrawing.dartBorders` takes the
positive-I wedge on the left. `wholePlaneFaceSucc` is inverse rotation after
`wholePlaneDartFlip`. Thus its orbit follows the left face of its dart.
`wholePlaneDartVertex` puts `(e, false)` at the west endpoint, whereas
`futureMapBoundaryDart` is `(e, true)` and
`futureMapBoundaryDart_external` places that reverse dart on the outer face.
Consequently `(e, false)` selects the left side when traversing west to east.
These conventions alone do not prove the plane complementary-face correspondence. -/
@[expose] def m0CutLeftStep (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (S : WholePlaneEdge W → Prop) (d e : WholePlaneDart W) : Prop :=
  e = wholePlaneFaceSucc W H d ∨ (e = wholePlaneDartFlip W d ∧ ¬ S d.1)

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
The rotation-system (face-orbit) side generated by west-to-east seam darts;
the complementary-component face correspondence in a plane drawing is separate. -/
@[expose] def m0CutLeftDarts (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (S : WholePlaneEdge W → Prop) : Set (WholePlaneDart W) :=
  {d | ∃ e, S e ∧ Relation.ReflTransGen (m0CutLeftStep W H S) (e, false) d}

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
The run-zero darts off the outer face are closed under the cut steps.
This concerns the rotation-system side, with plane face correspondence separate. -/
theorem m0Cut_runZero_step_closed (W : ℤ → Fin 3)
    (H : WholePlaneRotationHypothesis W)
    (h : BoundaryHitWitnesses (shiftedStream W 0)) (S : WholePlaneEdge W → Prop)
    (hS : ∀ e, S e ↔
      e ∈ wholePlaneEdgeι W 0 '' boundaryOuterEdgeSet (shiftedStream W 0) h)
    {a b : WholePlaneDart W}
    (ha : a ∈ wholePlaneDartι W 0 ''
      {d | ∀ k : ℤ, d ≠ futureMapBoundaryDart (shiftedStream W 0) h k})
    (hab : m0CutLeftStep W H S a b) :
    b ∈ wholePlaneDartι W 0 ''
      {d | ∀ k : ℤ, d ≠ futureMapBoundaryDart (shiftedStream W 0) h k} := by
  obtain ⟨d, hd, rfl⟩ := ha
  rcases hab with rfl | ⟨rfl, hnS⟩
  · refine ⟨kmswInfFaceSucc (shiftedStream W 0) (H.1 0) d, ?_,
      (m0Cut_faceSucc_runZero_of_not_outer W H h d hd).symm⟩
    intro k hk
    have hp := futureMapBoundaryDart_faceSucc (shiftedStream W 0) (H.1 0) h (k + 1)
    have hi : k + 1 - 1 = k := by omega
    rw [hi] at hp
    exact hd (k + 1) ((kmswInfFaceSucc (shiftedStream W 0) (H.1 0)).injective
      (hk.trans hp.symm))
  · refine ⟨(d.1, !d.2), ?_, rfl⟩
    intro k hk
    apply hnS
    apply (hS _).mpr
    refine ⟨boundaryOuterEdge (shiftedStream W 0) h k, ?_, ?_⟩
    · rw [← boundaryOuterEdge_range]
      exact ⟨k, rfl⟩
    · exact congrArg (wholePlaneEdgeι W 0) (congrArg Prod.fst hk).symm

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Every dart on the generated rotation-system left side is a run-zero non-outer
dart. The complementary-component face correspondence in a plane drawing is separate. -/
theorem m0Cut_leftDarts_subset_runZero (W : ℤ → Fin 3)
    (H : WholePlaneRotationHypothesis W)
    (h : BoundaryHitWitnesses (shiftedStream W 0)) (S : WholePlaneEdge W → Prop)
    (hS : ∀ e, S e ↔
      e ∈ wholePlaneEdgeι W 0 '' boundaryOuterEdgeSet (shiftedStream W 0) h) :
    m0CutLeftDarts W H S ⊆ wholePlaneDartι W 0 ''
      {d | ∀ k : ℤ, d ≠ futureMapBoundaryDart (shiftedStream W 0) h k} := by
  rintro d ⟨e, he, hr⟩
  have hseed : (e, false) ∈ wholePlaneDartι W 0 ''
      {d | ∀ k : ℤ, d ≠ futureMapBoundaryDart (shiftedStream W 0) h k} := by
    obtain ⟨f, _, rfl⟩ := (hS e).mp he
    refine ⟨(f, false), ?_, rfl⟩
    intro k hk
    have hb := congrArg Prod.snd hk
    cases hb
  induction hr with
  | refl => exact hseed
  | tail _ hstep ih => exact m0Cut_runZero_step_closed W H h S hS ih hstep

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Closure of the rotation-system side; plane complementary-face correspondence is separate. -/
theorem m0Cut_leftDarts_step (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (S : WholePlaneEdge W → Prop) {a b : WholePlaneDart W}
    (ha : a ∈ m0CutLeftDarts W H S) (hab : m0CutLeftStep W H S a b) :
    b ∈ m0CutLeftDarts W H S := by
  obtain ⟨e, he, hr⟩ := ha
  exact ⟨e, he, hr.tail hab⟩

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Lower-left membership persists; this is combinatorial, with plane faces separate. -/
private theorem m0Cut_LL_mono (w : ℕ → Fin 3) {n m e : ℕ}
    (hnm : n ≤ m) (he : e ∈ (kmswStage w n).LL) :
    e ∈ (kmswStage w m).LL := by
  induction m, hnm using Nat.le_induction with
  | base => exact he
  | succ m _ ih =>
    change e ∈ (kmswStep (kmswStage w m) (w m)).LL
    unfold kmswStep
    cases kmswCodeStep (w m) with
    | down =>
      cases hs : (kmswStage w m).UR <;>
        simpa [kmswStepOfStep, hs, State.addEdge] using ih
    | up => simpa only [kmswStepOfStep, State.addEdge] using ih
    | left =>
      cases hs : (kmswStage w m).UL.dropLast.reverse with
      | cons a as => simpa only [kmswStepOfStep, hs, State.addEdge] using ih
      | nil =>
        simpa only [kmswStepOfStep, hs, State.addEdge, List.mem_cons] using
          (Or.inr ih)

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Lower-right membership persists; this is combinatorial, with plane faces separate. -/
private theorem m0Cut_LR_mono (w : ℕ → Fin 3) {n m e : ℕ}
    (hnm : n ≤ m) (he : e ∈ (kmswStage w n).LR) :
    e ∈ (kmswStage w m).LR := by
  induction m, hnm using Nat.le_induction with
  | base => exact he
  | succ m _ ih =>
    obtain ⟨t, ht⟩ := kmswStage_LR_succ_eq_append w m
    rw [ht]
    exact List.mem_append_left _ ih

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Lower-stack edges are seam edges; the plane complementary-face correspondence is separate. -/
private theorem m0Cut_lower_mem_boundary (w : ℕ → Fin 3) (h : BoundaryHitWitnesses w)
    (n e : ℕ) (he : e ∈ (kmswStage w n).LR ∨ e ∈ (kmswStage w n).LL) :
    e ∈ boundaryOuterEdgeSet w h := by
  rw [← boundaryOuterEdge_range]
  rcases he with he | he
  · have hr : e ∈ Set.range (kmswRightBoundaryEdge w) := by
      rw [← kmswRunEventuallyLR_eq_range w h]
      exact ⟨n, fun m hm => m0Cut_LR_mono w hm he⟩
    obtain ⟨j, hj⟩ := hr
    by_cases hj0 : j = 0
    · subst j
      exact ⟨0, (boundaryOuterEdge_zero w h).trans
        ((kmswRightBoundaryEdge_zero w).symm.trans hj)⟩
    · refine ⟨(j : ℤ), ?_⟩
      rw [boundaryOuterEdge_of_positive w h (by omega), Int.toNat_natCast]
      exact hj
  · have hr : e ∈ Set.range (fun j : ℕ =>
        kmswLLCreatedEdge w (boundaryHitTime w h (-((j : ℤ) + 1)))) := by
      rw [← kmswRunEventuallyLL_eq_range w h]
      exact ⟨n, fun m hm => m0Cut_LL_mono w hm he⟩
    obtain ⟨j, hj⟩ := hr
    refine ⟨-((j : ℤ) + 1), ?_⟩
    rw [boundaryOuterEdge_of_negative w h (by omega)]
    exact hj

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Reaching one triangle dart reaches its entire rotation-system face orbit;
plane complementary-face correspondence is separate. -/
private theorem m0Cut_triangle_reachable_of_one (W : ℤ → Fin 3)
    (H : WholePlaneRotationHypothesis W) (S : WholePlaneEdge W → Prop)
    (j : TriangleCreationTime (shiftedStream W 0)) (a : ℕ × Bool)
    (ha : a ∈ stageTriangleDartList (shiftedStream W 0) j)
    (hra : wholePlaneDartι W 0 a ∈ m0CutLeftDarts W H S) (d : ℕ × Bool)
    (hd : d ∈ stageTriangleDartList (shiftedStream W 0) j) :
    wholePlaneDartι W 0 d ∈ m0CutLeftDarts W H S := by
  let t := stageTriangleDartTriple (shiftedStream W 0) j
  have hc := kmswInfFaceSucc_stageTriangle_cycle (shiftedStream W 0) (H.1 0) j
  change FaceSucc3Cycle _ t.1 t.2.1 t.2.2 at hc
  have hs (x : ℕ × Bool) (hx : x ∈ stageTriangleDartList (shiftedStream W 0) j)
      (hrx : wholePlaneDartι W 0 x ∈ m0CutLeftDarts W H S) :
      wholePlaneDartι W 0 (kmswInfFaceSucc (shiftedStream W 0) (H.1 0) x) ∈
        m0CutLeftDarts W H S := by
    rw [← m0Cut_faceSucc_runZero_of_triangle W H x ⟨j, hx⟩]
    exact m0Cut_leftDarts_step W H S hrx (Or.inl rfl)
  have h1 : t.1 ∈ stageTriangleDartList (shiftedStream W 0) j := by
    simp only [stageTriangleDartList, t, List.mem_cons, true_or]
  have h2 : t.2.1 ∈ stageTriangleDartList (shiftedStream W 0) j := by
    simp only [stageTriangleDartList, t, List.mem_cons, true_or, or_true]
  have h3 : t.2.2 ∈ stageTriangleDartList (shiftedStream W 0) j := by
    simp only [stageTriangleDartList, t, List.mem_cons, true_or, or_true]
  have hs1 : wholePlaneDartι W 0 t.1 ∈ m0CutLeftDarts W H S →
      wholePlaneDartι W 0 t.2.1 ∈ m0CutLeftDarts W H S := by
    intro hr
    simpa only [hc.1] using hs t.1 h1 hr
  have hs2 : wholePlaneDartι W 0 t.2.1 ∈ m0CutLeftDarts W H S →
      wholePlaneDartι W 0 t.2.2 ∈ m0CutLeftDarts W H S := by
    intro hr
    simpa only [hc.2.1] using hs t.2.1 h2 hr
  have hs3 : wholePlaneDartι W 0 t.2.2 ∈ m0CutLeftDarts W H S →
      wholePlaneDartι W 0 t.1 ∈ m0CutLeftDarts W H S := by
    intro hr
    simpa only [hc.2.2.1] using hs t.2.2 h3 hr
  simp only [stageTriangleDartList, List.mem_cons, List.not_mem_nil, or_false] at ha hd
  have hall : wholePlaneDartι W 0 t.1 ∈ m0CutLeftDarts W H S ∧
      wholePlaneDartι W 0 t.2.1 ∈ m0CutLeftDarts W H S ∧
      wholePlaneDartι W 0 t.2.2 ∈ m0CutLeftDarts W H S := by
    rcases ha with rfl | rfl | rfl
    · exact ⟨hra, hs1 hra, hs2 (hs1 hra)⟩
    · exact ⟨hs3 (hs2 hra), hra, hs2 hra⟩
    · exact ⟨hs3 hra, hs1 (hs3 hra), hra⟩
  rcases hd with rfl | rfl | rfl
  · exact hall.1
  · exact hall.2.1
  · exact hall.2.2

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Every recorded triangle belongs to the rotation-system side, by induction on
creation time through the old-active side; plane face correspondence is separate. -/
theorem m0Cut_triangle_reachable (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (h : BoundaryHitWitnesses (shiftedStream W 0)) (S : WholePlaneEdge W → Prop)
    (hS : ∀ e, S e ↔
      e ∈ wholePlaneEdgeι W 0 '' boundaryOuterEdgeSet (shiftedStream W 0) h)
    (j : TriangleCreationTime (shiftedStream W 0)) (d : ℕ × Bool)
    (hd : d ∈ stageTriangleDartList (shiftedStream W 0) j) :
    wholePlaneDartι W 0 d ∈ m0CutLeftDarts W H S := by
  classical
  suffices hall : ∀ n, ∀ j : TriangleCreationTime (shiftedStream W 0), j.val = n →
      ∀ d ∈ stageTriangleDartList (shiftedStream W 0) j,
        wholePlaneDartι W 0 d ∈ m0CutLeftDarts W H S from hall j.val j rfl d hd
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro j hj d hd
    let w := shiftedStream W 0
    let a := (kmswStage w j.val).active
    have ha : (a, false) ∈ stageTriangleDartList w j := by
      dsimp only [stageTriangleDartList, stageTriangleDartTriple]
      split
      · split <;> simp only [a, List.mem_cons, true_or, or_true]
      · simp only [a, List.mem_cons, true_or]
    apply m0Cut_triangle_reachable_of_one W H S j (a, false) ha ?_ d hd
    by_cases hSa : S (wholePlaneEdgeι W 0 a)
    · exact ⟨wholePlaneEdgeι W 0 a, hSa, .refl⟩
    · let x : StageDart (kmswStage w j.val).nextEdge :=
        (⟨a, act_lt_nextEdge w (le_refl j.val)⟩, true)
      rcases stage_dart_partition w j.val x with ho | ⟨i, hi, _⟩
      · have hlow : a ∈ (kmswStage w j.val).LR ∨ a ∈ (kmswStage w j.val).LL := by
          simpa only [x, Bool.true_eq_false, false_and, false_or, true_and] using
            (stageOuterWord_mem_iff w j.val x).mp ho
        exact (hSa ((hS _).mpr ⟨a, m0Cut_lower_mem_boundary w h j.val a hlow, rfl⟩)).elim
      · have hr := ih i.val (by omega) i rfl (a, true) hi.2
        exact m0Cut_leftDarts_step W H S hr (Or.inr ⟨rfl, hSa⟩)

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Every run-zero non-outer dart lies on a recorded triangle. This is the
rotation-system partition; plane complementary-face correspondence is separate. -/
private theorem m0Cut_triangle_of_not_outer (w : ℕ → Fin 3)
    (h : BoundaryHitWitnesses w) (d : ℕ × Bool)
    (hd : ∀ k : ℤ, d ≠ futureMapBoundaryDart w h k) :
    ∃ j : TriangleCreationTime w, d ∈ stageTriangleDartList w j := by
  classical
  have hL : ∀ a : ℤ, ∃ n, L w n ≤ a := by
    intro a
    obtain ⟨n, hn⟩ := h.leftHit (min a (-1)) (min_le_right _ _)
    exact ⟨n, hn.le.trans (min_le_left _ _)⟩
  have hR : ∀ a : ℤ, ∃ n, R w n ≤ a := by
    intro a
    obtain ⟨n, hn⟩ := h.rightHit (max (-a) 1) (le_max_right _ _)
    exact ⟨n, by have hm := le_max_left (-a) 1; omega⟩
  by_contra ht
  rcases (kmswRunInfDart_boundary_iff_not_triangle w hL hR d).mpr ht with
    ⟨e, he, rfl⟩ | ⟨e, he, rfl⟩
  · have hr : e ∈ Set.range (fun j : ℕ =>
        kmswLLCreatedEdge w (boundaryHitTime w h (-((j : ℤ) + 1)))) := by
      rw [← kmswRunEventuallyLL_eq_range w h]
      exact he
    obtain ⟨j, hj⟩ := hr
    dsimp only at hj
    apply hd (-((j : ℤ) + 1))
    rw [futureMapBoundaryDart, boundaryOuterEdge_of_negative w h (by omega), hj]
  · have hr : e ∈ Set.range (kmswRightBoundaryEdge w) := by
      rw [← kmswRunEventuallyLR_eq_range w h]
      exact he
    obtain ⟨j, hj⟩ := hr
    by_cases hj0 : j = 0
    · subst j
      apply hd 0
      rw [futureMapBoundaryDart_zero, ← hj, kmswRightBoundaryEdge_zero]
      rfl
    · apply hd (j : ℤ)
      rw [futureMapBoundaryDart, boundaryOuterEdge_of_positive w h (by omega),
        Int.toNat_natCast, hj]

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
The generated rotation-system (face-orbit) side equals the run-zero non-outer
triangle darts. The complementary-component face correspondence in a plane
drawing and identification of S with the source paths are separate obligations. -/
theorem m0Cut_leftDarts_eq_runZero (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (h : BoundaryHitWitnesses (shiftedStream W 0)) (S : WholePlaneEdge W → Prop)
    (hS : ∀ e, S e ↔
      e ∈ wholePlaneEdgeι W 0 '' boundaryOuterEdgeSet (shiftedStream W 0) h) :
    m0CutLeftDarts W H S = wholePlaneDartι W 0 ''
      {d | ∀ k : ℤ, d ≠ futureMapBoundaryDart (shiftedStream W 0) h k} := by
  apply Set.Subset.antisymm (m0Cut_leftDarts_subset_runZero W H h S hS)
  rintro a ⟨d, hd, rfl⟩
  obtain ⟨j, hj⟩ := m0Cut_triangle_of_not_outer (shiftedStream W 0) h d hd
  exact m0Cut_triangle_reachable W H h S hS j d hj

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Geometric edge identities on the rotation-system side, including missing edges;
plane complementary-face correspondence and directed presence are separate. -/
@[expose] def m0CutLeftEdges (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (S : WholePlaneEdge W → Prop) : Set (WholePlaneEdge W) :=
  Prod.fst '' m0CutLeftDarts W H S

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
Vertices incident to rotation-system left darts; the complementary-component
face correspondence in a plane drawing is separate. -/
@[expose] def m0CutLeftVertices (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (S : WholePlaneEdge W → Prop) : Set (WholePlaneVertex W) :=
  wholePlaneDartVertex W '' m0CutLeftDarts W H S

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
All run-zero west darts are on the rotation-system side, with plane face
correspondence separate. -/
private theorem m0Cut_west_mem (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (h : BoundaryHitWitnesses (shiftedStream W 0)) (S : WholePlaneEdge W → Prop)
    (hS : ∀ e, S e ↔
      e ∈ wholePlaneEdgeι W 0 '' boundaryOuterEdgeSet (shiftedStream W 0) h) (e : ℕ) :
    wholePlaneDartι W 0 (e, false) ∈ m0CutLeftDarts W H S := by
  rw [m0Cut_leftDarts_eq_runZero W H h S hS]
  refine ⟨(e, false), ?_, rfl⟩
  intro k hk
  have hb := congrArg Prod.snd hk
  cases hb

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
The rotation-system left edges are exactly all geometric run-zero edges.
This retains missing edges; plane face correspondence and presence are separate. -/
theorem m0Cut_leftEdges_eq_runZero (W : ℤ → Fin 3) (H : WholePlaneRotationHypothesis W)
    (h : BoundaryHitWitnesses (shiftedStream W 0)) (S : WholePlaneEdge W → Prop)
    (hS : ∀ e, S e ↔
      e ∈ wholePlaneEdgeι W 0 '' boundaryOuterEdgeSet (shiftedStream W 0) h) :
    m0CutLeftEdges W H S = Set.range (wholePlaneEdgeι W 0) := by
  apply Set.Subset.antisymm
  · rintro e ⟨a, ha, rfl⟩
    obtain ⟨d, _, rfl⟩ := m0Cut_leftDarts_subset_runZero W H h S hS ha
    exact ⟨d.1, rfl⟩
  · rintro e ⟨f, rfl⟩
    exact ⟨wholePlaneDartι W 0 (f, false), m0Cut_west_mem W H h S hS f, rfl⟩

/-- Helper toward Theorem 1.4 (thm-busemann; M_{0,∞} identification,
Q-M0-repr proof obligation); not a paper result.
The rotation-system left vertices are exactly all run-zero vertices.
The complementary-component face correspondence in a plane drawing is separate. -/
theorem m0Cut_leftVertices_eq_runZero (W : ℤ → Fin 3)
    (H : WholePlaneRotationHypothesis W)
    (h : BoundaryHitWitnesses (shiftedStream W 0)) (S : WholePlaneEdge W → Prop)
    (hS : ∀ e, S e ↔
      e ∈ wholePlaneEdgeι W 0 '' boundaryOuterEdgeSet (shiftedStream W 0) h) :
    m0CutLeftVertices W H S = Set.range (wholePlaneVertexι W 0) := by
  apply Set.Subset.antisymm
  · rintro v ⟨a, ha, rfl⟩
    obtain ⟨d, _, rfl⟩ := m0Cut_leftDarts_subset_runZero W H h S hS ha
    exact ⟨kmswLimitDartVertex (shiftedStream W 0) d, (wholePlaneDartVertex_ι W 0 d).symm⟩
  · rintro v ⟨u, rfl⟩
    obtain ⟨e, _, he⟩ := kmswM0_vertex_outgoing (shiftedStream W 0) (H.1 0) h u
    refine ⟨wholePlaneDartι W 0 (e, false), m0Cut_west_mem W H h S hS e, ?_⟩
    rw [wholePlaneDartVertex_ι]
    exact congrArg (wholePlaneVertexι W 0) he

end DirectedDistances.KMSW
