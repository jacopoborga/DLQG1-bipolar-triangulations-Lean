/-! # Radial wedge winding

Helpers toward Proposition 5.16. These are dependency lemmas; the general
radial-order transport theorem requires a separate geometric argument. -/

public section

noncomputable section

namespace DirectedDistances.PlanarMap

open scoped ComplexConjugate

/-- Helper toward Proposition 5.16: a closed radial wedge is convex. -/
theorem d39ClosedWedge_convex (u v : ℂ) : Convex ℝ (d39ClosedWedge u v) := by
  intro x hx y hy a b ha hb hab
  rcases hx with ⟨s, t, hs, ht, rfl⟩
  rcases hy with ⟨s', t', hs', ht', rfl⟩
  refine ⟨a * s + b * s', a * t + b * t',
    add_nonneg (mul_nonneg ha hs) (mul_nonneg hb hs'),
    add_nonneg (mul_nonneg ha ht) (mul_nonneg hb ht'), ?_⟩
  apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im] <;> ring

/-- Helper toward Proposition 5.16: the origin belongs to every closed wedge. -/
theorem d39_zero_mem_closedWedge (u v : ℂ) : (0 : ℂ) ∈ d39ClosedWedge u v := by
  exact ⟨0, 0, le_rfl, le_rfl, by simp⟩

/-- Helper toward Proposition 5.16: a triangle with positive radius lies in
the closed wedge generated by its two nonzero vertices. -/
theorem d39_triangle_image_subset_closedWedge (r : ℝ) (u v : ℂ) (hr : 0 ≤ r) :
    (d39TrianglePolyline r u v).image ⊆ d39ClosedWedge u v := by
  have h0 := d39_zero_mem_closedWedge u v
  have hu : (r : ℂ) * u ∈ d39ClosedWedge u v :=
    ⟨r, 0, hr, le_rfl, by simp⟩
  have hv : (r : ℂ) * v ∈ d39ClosedWedge u v :=
    ⟨0, r, le_rfl, hr, by simp⟩
  intro z hz
  change z = (d39TrianglePolyline r u v).start ∨
    ∃ i, i + 1 < (d39TrianglePolyline r u v).points.length ∧
      z ∈ (d39TrianglePolyline r u v).segmentAt i at hz
  rcases hz with hz | ⟨i, hi, hz⟩
  · simpa [hz, d39TrianglePolyline, Polyline.start] using h0
  · have hlen : (d39TrianglePolyline r u v).points.length = 4 := by
      simp [d39TrianglePolyline]
    have hi' : i < 3 := by omega
    have hconv := d39ClosedWedge_convex u v
    interval_cases i
    · exact hconv.segment_subset h0 hu (by
        simpa [d39TrianglePolyline, Polyline.segmentAt, Polyline.point, Polyline.start] using hz)
    · exact hconv.segment_subset hu hv (by
        simpa [d39TrianglePolyline, Polyline.segmentAt, Polyline.point, Polyline.start] using hz)
    · exact hconv.segment_subset hv h0 (by
        simpa [d39TrianglePolyline, Polyline.segmentAt, Polyline.point, Polyline.start] using hz)

/-- Helper toward Proposition 5.16: contraction within a convex set proves
that a loop in that set has winding zero about every point outside it. -/
theorem d39_hasWinding_zero_of_convex
    {z w : ℂ} (L : Path z z) (C : Set ℂ) (hC : Convex ℝ C)
    (hrange : Set.range L ⊆ C) (hw : w ∉ C) : HasWinding L w 0 := by
  have hz : z ∈ C := hrange ⟨0, L.source⟩
  have hzw : z - w ≠ 0 := sub_ne_zero.mpr (fun h => hw (h ▸ hz))
  have hconst : HasWinding (Path.refl z) w 0 := by
    refine ⟨⟨fun _ => Complex.log (z - w), continuous_const⟩, ?_, ?_⟩
    · intro t
      exact Complex.exp_log hzw
    · simp
  let H : C(unitInterval × unitInterval, ℂ) :=
    ⟨fun p => (1 - (p.1 : ℝ)) • z + (p.1 : ℝ) • L p.2, by fun_prop⟩
  apply hasWinding_homotopy H (L₀ := Path.refl z) (L₁ := L)
  · intro t
    simp [H]
  · intro t
    simp [H]
  · intro t
    simp [H, L.source, L.target]
  · intro t s heq
    apply hw
    rw [← heq]
    exact hC hz (hrange ⟨s, rfl⟩) (sub_nonneg.mpr t.2.2) t.2.1 (by ring)
  · exact hconst

/-- Helper toward Proposition 5.16: every point outside the closed wedge
avoids the triangle and has angle sum and logarithmic winding both zero. -/
theorem d39_triangle_exterior_hasWinding_zero
    (r : ℝ) (u v z : ℂ) (hr : 0 ≤ r) (hz : z ∉ d39ClosedWedge u v) :
    z ∉ (d39TrianglePolyline r u v).image ∧
      (d39TrianglePolyline r u v).angleSum z = 0 ∧
      HasWinding ((d39TrianglePolyline r u v).toPath.cast rfl
        (d39TrianglePolyline_closed r u v)) z 0 := by
  have hsub := d39_triangle_image_subset_closedWedge r u v hr
  have havoid : z ∉ (d39TrianglePolyline r u v).image := fun h => hz (hsub h)
  have hwind : HasWinding ((d39TrianglePolyline r u v).toPath.cast rfl
      (d39TrianglePolyline_closed r u v)) z 0 := by
    apply d39_hasWinding_zero_of_convex _ _ (d39ClosedWedge_convex u v) _ hz
    intro x hx
    apply hsub
    rw [← Polyline.range_toPath]
    exact hx
  refine ⟨havoid, ?_, hwind⟩
  have hsum := (hasWinding_iff_angleSum_eq_int (d39TrianglePolyline r u v)
    (d39TrianglePolyline_closed r u v) z 0 havoid).1 hwind
  simpa using hsum

/-- Helper toward Proposition 5.16: the oriented determinant of two rays is
the product of their norms and the sine of their counterclockwise turn. -/
theorem d39_det_eq_norm_mul_sin_ccwTurn (u v : ℂ) :
    (conj u * v).im = ‖u‖ * ‖v‖ * Real.sin (ccwTurn u v) := by
  have hsin : Real.sin (ccwTurn u v) = Real.sin (v.arg - u.arg) := by
    unfold ccwTurn
    split_ifs
    · rfl
    · exact Real.sin_add_two_pi _
  rw [hsin, Real.sin_sub]
  simp only [Complex.mul_im, Complex.conj_re, Complex.conj_im]
  rw [← Complex.norm_mul_cos_arg u, ← Complex.norm_mul_sin_arg u,
    ← Complex.norm_mul_cos_arg v, ← Complex.norm_mul_sin_arg v]
  ring

/-- Helper toward Proposition 5.16: turns strictly between zero and `pi`
give a positive oriented determinant. -/
theorem d39_det_pos_of_ccwTurn_lt_pi (u v : ℂ) (hu : u ≠ 0) (hv : v ≠ 0)
    (hpos : 0 < ccwTurn u v) (hpi : ccwTurn u v < Real.pi) :
    0 < (conj u * v).im := by
  rw [d39_det_eq_norm_mul_sin_ccwTurn]
  exact mul_pos (mul_pos (norm_pos_iff.mpr hu) (norm_pos_iff.mpr hv))
    (Real.sin_pos_of_pos_of_lt_pi hpos hpi)

/-- Helper toward Proposition 5.16: positive area leaves a uniform disk
about zero strictly on the origin side of the triangle's opposite chord. -/
theorem d39_triangle_chord_positive_near_zero
    (r : ℝ) (u v : ℂ) (hr : 0 < r) (harea : 0 < (conj u * v).im) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ z : ℂ, ‖z‖ < ε →
      0 < (conj ((r : ℂ) * v - (r : ℂ) * u) *
        (z - (r : ℂ) * u)).im := by
  let f : ℂ → ℝ := fun z =>
    (conj ((r : ℂ) * v - (r : ℂ) * u) * (z - (r : ℂ) * u)).im
  have hf : Continuous f := by fun_prop
  have hf0 : 0 < f 0 := by
    have heq : f 0 = r * r * (conj u * v).im := by
      simp [f, Complex.mul_im]
      ring
    rw [heq]
    exact mul_pos (mul_pos hr hr) harea
  have hnear := hf.continuousAt.preimage_mem_nhds (Ioi_mem_nhds hf0)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hnear
  refine ⟨ε, hε, ?_⟩
  intro z hz
  exact hball (by simpa [Metric.mem_ball, dist_zero_right] using hz)

/-- Helper toward Proposition 5.16: in a uniform disk, points strictly
between the two rays have triangle winding one; points outside the closed
wedge have triangle winding zero. -/
theorem d39_triangle_winding_near_zero
    (r : ℝ) (u v : ℂ) (hr : 0 < r) (hu : u ≠ 0) (hv : v ≠ 0)
    (hpos : 0 < ccwTurn u v) (hpi : ccwTurn u v < Real.pi) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ z : ℂ, ‖z‖ < ε →
      ((0 < (conj u * z).im ∧ 0 < (conj z * v).im) →
        z ∉ (d39TrianglePolyline r u v).image ∧
        (d39TrianglePolyline r u v).angleSum z = 1 ∧
        HasWinding ((d39TrianglePolyline r u v).toPath.cast rfl
          (d39TrianglePolyline_closed r u v)) z 1) ∧
      (z ∉ d39ClosedWedge u v →
        z ∉ (d39TrianglePolyline r u v).image ∧
        (d39TrianglePolyline r u v).angleSum z = 0 ∧
        HasWinding ((d39TrianglePolyline r u v).toPath.cast rfl
          (d39TrianglePolyline_closed r u v)) z 0) := by
  obtain ⟨ε, hε, hchord⟩ := d39_triangle_chord_positive_near_zero r u v hr
    (d39_det_pos_of_ccwTurn_lt_pi u v hu hv hpos hpi)
  refine ⟨ε, hε, ?_⟩
  intro z hz
  constructor
  · rintro ⟨huz, hzv⟩
    have h0 : 0 < (conj ((r : ℂ) * u) * z).im := by
      have heq : (conj ((r : ℂ) * u) * z).im = r * (conj u * z).im := by
        simp [Complex.mul_im]
        ring
      rw [heq]
      exact mul_pos hr huz
    have h1 := hchord z hz
    have h2 : 0 < (conj (0 - (r : ℂ) * v) * (z - (r : ℂ) * v)).im := by
      have heq : (conj (0 - (r : ℂ) * v) * (z - (r : ℂ) * v)).im =
          r * (conj z * v).im := by
        simp [Complex.mul_im]
        ring
      rw [heq]
      exact mul_pos hr hzv
    have havoid := d39_triangle_not_mem_image_of_leftSides r u v z h0 h1 h2
    have ha0 : 0 < (d39TrianglePolyline r u v).edgeAngle z 0 := by
      apply (d39_edgeAngle_mem_Ioo_of_leftOf _ _ _ ?_).1
      simpa [d39TrianglePolyline, Polyline.point, Polyline.start] using h0
    have ha1 : 0 < (d39TrianglePolyline r u v).edgeAngle z 1 := by
      apply (d39_edgeAngle_mem_Ioo_of_leftOf _ _ _ ?_).1
      exact h1
    have ha2 : 0 < (d39TrianglePolyline r u v).edgeAngle z 2 := by
      apply (d39_edgeAngle_mem_Ioo_of_leftOf _ _ _ ?_).1
      exact h2
    exact ⟨havoid,
      d39_triangle_angleSum_eq_one_of_positive_edgeAngles r u v z havoid ha0 ha1 ha2,
      d39_triangle_hasWinding_one_of_positive_edgeAngles r u v z havoid ha0 ha1 ha2⟩
  · exact d39_triangle_exterior_hasWinding_zero r u v z hr.le

/-- Helper toward Proposition 5.16: below a half-turn, the principal
argument of the quotient equals the positive counterclockwise turn. -/
theorem d39_arg_div_eq_ccwTurn (u v : ℂ) (hu : u ≠ 0) (hv : v ≠ 0)
    (hpos : 0 < ccwTurn u v) (hpi : ccwTurn u v < Real.pi) :
    Complex.arg (v / u) = ccwTurn u v := by
  have hcoe : (Complex.arg (v / u) : Real.Angle) = (ccwTurn u v : ℝ) := by
    rw [Complex.arg_div_coe_angle hv hu]
    unfold ccwTurn
    split_ifs
    · rw [Real.Angle.coe_sub]
    · rw [Real.Angle.coe_add, Real.Angle.coe_sub, Real.Angle.coe_two_pi, add_zero]
  calc
    Complex.arg (v / u) = (Complex.arg (v / u) : Real.Angle).toReal :=
      (Complex.arg_coe_angle_toReal_eq_arg _).symm
    _ = (ccwTurn u v : Real.Angle).toReal := congrArg Real.Angle.toReal hcoe
    _ = ccwTurn u v := Real.Angle.toReal_coe_eq_self_iff.mpr
      ⟨lt_trans (neg_lt_zero.mpr Real.pi_pos) hpos, hpi.le⟩

/-- Helper toward Proposition 5.16: lifting the positive turn from a ray
gives the usual unit vector in the terminal direction, across the argument cut. -/
theorem d39_exp_arg_add_ccwTurn (u w : ℂ) :
    Complex.exp (((u.arg + ccwTurn u w : ℝ) : ℂ) * Complex.I) =
      Complex.exp ((w.arg : ℂ) * Complex.I) := by
  unfold ccwTurn
  split_ifs
  · congr 2
    push_cast
    ring
  · have heq : (((u.arg + (w.arg - u.arg + 2 * Real.pi) : ℝ) : ℂ) * Complex.I) =
        (w.arg : ℂ) * Complex.I + 2 * Real.pi * Complex.I := by
      push_cast
      ring
    rw [heq]
    exact Complex.exp_periodic _

/-- Helper toward Proposition 5.16: the angular test point is a positive
real multiple of its prescribed direction. -/
theorem d39_radial_testPoint_eq (u w : ℂ) (hw : w ≠ 0) (ρ : ℝ) :
    (ρ : ℂ) * Complex.exp (((u.arg + ccwTurn u w : ℝ) : ℂ) * Complex.I) =
      ((ρ / ‖w‖ : ℝ) : ℂ) * w := by
  rw [d39_exp_arg_add_ccwTurn]
  calc
    _ = ((ρ / ‖w‖ : ℝ) : ℂ) *
        ((‖w‖ : ℂ) * Complex.exp ((w.arg : ℂ) * Complex.I)) := by
      push_cast
      field_simp [norm_ne_zero_iff.mpr hw]
    _ = _ := by rw [Complex.norm_mul_exp_arg_mul_I]

/-- Helper toward Proposition 5.16: a logarithmic winding lift excludes
the reference point from the loop image. -/
theorem d39_not_mem_range_of_hasWinding {a w : ℂ} {L : Path a a} {n : ℤ}
    (h : HasWinding L w n) : w ∉ Set.range L := by
  obtain ⟨φ, hφ, _⟩ := h
  rintro ⟨t, ht⟩
  have heq := hφ t
  rw [ht, sub_self] at heq
  exact Complex.exp_ne_zero _ heq

/-- Helper toward Proposition 5.16: a nonnegative combination of the wedge
rays lies on the nonnegative side of the terminal ray. -/
theorem d39_det_nonneg_of_mem_closedWedge (u v z : ℂ)
    (harea : 0 ≤ (conj u * v).im) (hz : z ∈ d39ClosedWedge u v) :
    0 ≤ (conj z * v).im := by
  rcases hz with ⟨s, t, hs, ht, rfl⟩
  have heq : (conj ((s : ℂ) * u + (t : ℂ) * v) * v).im =
      s * (conj u * v).im := by
    simp [Complex.mul_im]
    ring
  rw [heq]
  exact mul_nonneg hs harea

/-- Helper toward Proposition 5.16: the one-triangle wedge loop detects
strict angular betweenness for all sufficiently small radial test points. -/
theorem d39_wedgeLoop_hasWinding_one_iff_turn_lt
    (r : ℝ) (u v w : ℂ) (hr : 0 < r)
    (hu : u ≠ 0) (hv : v ≠ 0) (hw : w ≠ 0)
    (huv : 0 < ccwTurn u v) (huvPi : ccwTurn u v < Real.pi)
    (huw : 0 < ccwTurn u w) (huwPi : ccwTurn u w < Real.pi) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ ρ : ℝ, 0 < ρ → ρ < ε →
      (HasWinding (d39WedgeLoop r u v)
        ((ρ : ℂ) * Complex.exp
          (((u.arg + ccwTurn u w : ℝ) : ℂ) * Complex.I)) 1 ↔
        ccwTurn u w < ccwTurn u v) := by
  obtain ⟨ε, hε, hnear⟩ := d39_triangle_winding_near_zero r u v hr hu hv huv huvPi
  refine ⟨min ε (r * ‖v‖), lt_min hε (mul_pos hr (norm_pos_iff.mpr hv)), ?_⟩
  intro ρ hρ hρε
  let z : ℂ := (ρ : ℂ) * Complex.exp
    (((u.arg + ccwTurn u w : ℝ) : ℂ) * Complex.I)
  have hzform : z = ((ρ / ‖w‖ : ℝ) : ℂ) * w := d39_radial_testPoint_eq u w hw ρ
  have hzNorm : ‖z‖ = ρ := by
    dsimp only [z]
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hρ]
  have hzε : ‖z‖ < ε := by rw [hzNorm]; exact lt_of_lt_of_le hρε (min_le_left _ _)
  have hρv : ρ < r * ‖v‖ := lt_of_lt_of_le hρε (min_le_right _ _)
  have hk : 0 < ρ / ‖w‖ := div_pos hρ (norm_pos_iff.mpr hw)
  have hscale0 : (conj u * z).im = (ρ / ‖w‖) * (conj u * w).im := by
    rw [hzform]
    simp [Complex.mul_im]
    ring
  have hscale2 : (conj z * v).im = (ρ / ‖w‖) * (conj w * v).im := by
    rw [hzform]
    simp [Complex.mul_im]
    ring
  have hpath : HasWinding (d39WedgeLoop r u v) z 1 ↔
      HasWinding ((d39TrianglePolyline r u v).toPath.cast rfl
        (d39TrianglePolyline_closed r u v)) z 1 := by
    change (∃ φ : C(unitInterval, ℂ),
      (∀ t, Complex.exp (φ t) = (d39WedgePolyline r u v).toPath t - z) ∧
        φ 1 - φ 0 = 2 * Real.pi * Complex.I * (1 : ℤ)) ↔ _
    rw [show d39WedgePolyline r u v = d39TrianglePolyline r u v from
      ite_eq_left huvPi]
    rfl
  change HasWinding (d39WedgeLoop r u v) z 1 ↔ _
  rw [hpath]
  constructor
  · intro hwind
    by_contra hnot
    rcases lt_or_eq_of_le (le_of_not_gt hnot) with hlt | heq
    · have hcomp := ccwTurn_comp_add hlt
      have hdet : 0 < (conj v * w).im := d39_det_pos_of_ccwTurn_lt_pi v w hv hw
        (ccwTurn_pos v w) (by linarith)
      have hneg : (conj w * v).im < 0 := by
        have heqdet : (conj w * v).im = -(conj v * w).im := by
          simp [Complex.mul_im]
          ring
        rw [heqdet]
        exact neg_neg_of_pos hdet
      have hzout : z ∉ d39ClosedWedge u v := by
        intro hzmem
        have hnonneg := d39_det_nonneg_of_mem_closedWedge u v z
          (d39_det_pos_of_ccwTurn_lt_pi u v hu hv huv huvPi).le hzmem
        rw [hscale2] at hnonneg
        exact (not_lt_of_ge hnonneg) (mul_neg_of_pos_of_neg hk hneg)
      have hzero := (d39_triangle_exterior_hasWinding_zero r u v z hr.le hzout).2.2
      have hcontra := hasWinding_unique hwind hzero
      norm_num at hcontra
    · have harg : v.arg = w.arg := ccwTurn_left_injective heq
      have hzformV : z = ((ρ / ‖v‖ : ℝ) : ℂ) * v := by
        have heqTest : z = (ρ : ℂ) * Complex.exp
            (((u.arg + ccwTurn u v : ℝ) : ℂ) * Complex.I) := by
          dsimp [z]
          rw [heq]
        rw [heqTest]
        exact d39_radial_testPoint_eq u v hv ρ
      have hzseg : z ∈ segment ℝ 0 ((r : ℂ) * v) := by
        rw [segment_eq_image']
        refine ⟨ρ / (r * ‖v‖), ⟨(div_pos hρ (mul_pos hr (norm_pos_iff.mpr hv))).le,
          (div_lt_one (mul_pos hr (norm_pos_iff.mpr hv))).2 hρv |>.le⟩, ?_⟩
        rw [hzformV]
        dsimp only
        rw [sub_zero, zero_add, RCLike.real_smul_eq_coe_mul]
        change ((ρ / (r * ‖v‖) : ℝ) : ℂ) * ((r : ℂ) * v) =
          ((ρ / ‖v‖ : ℝ) : ℂ) * v
        rw [← mul_assoc, ← Complex.ofReal_mul]
        congr 2
        field_simp [hr.ne']
      have hzimage : z ∈ (d39TrianglePolyline r u v).image := by
        right
        refine ⟨2, by simp [d39TrianglePolyline], ?_⟩
        change z ∈ segment ℝ ((r : ℂ) * v) 0
        rw [segment_symm]
        exact hzseg
      apply d39_not_mem_range_of_hasWinding hwind
      rw [← Polyline.range_toPath] at hzimage
      exact hzimage
  · intro hlt
    have hcomp := ccwTurn_comp_add hlt
    have hdet0 := d39_det_pos_of_ccwTurn_lt_pi u w hu hw huw huwPi
    have hdet2 := d39_det_pos_of_ccwTurn_lt_pi w v hw hv (ccwTurn_pos w v)
      (by linarith)
    exact ((hnear z hzε).1 ⟨by rw [hscale0]; exact mul_pos hk hdet0,
      by rw [hscale2]; exact mul_pos hk hdet2⟩).2.2

/-- Helper toward Proposition 5.16: a path avoiding the reference point
has a complex logarithmic lift and hence a lift increment. -/
theorem d39_hasLiftIncrement_exists {a b w : ℂ} (g : Path a b)
    (hw : w ∉ Set.range g) : ∃ c : ℂ, HasLiftIncrement g w c := by
  let f : C(unitInterval, ℂ) := ⟨fun t => g t - w, g.continuous.sub continuous_const⟩
  have hzero (t : unitInterval) : f t ≠ 0 := by
    intro ht
    exact hw ⟨t, sub_eq_zero.mp ht⟩
  let γ : Path (⟨f 0, hzero 0⟩ : {x : ℂ // x ≠ 0})
      (⟨f 1, hzero 1⟩ : {x : ℂ // x ≠ 0}) :=
    { toFun := fun t => ⟨f t, hzero t⟩
      continuous_toFun := by fun_prop
      source' := rfl
      target' := rfl }
  let φ := Complex.isCoveringMap_exp.liftPath γ (Complex.log (f 0)) (by
    apply Subtype.ext
    exact (Complex.exp_log (hzero 0)).symm)
  refine ⟨φ 1 - φ 0, φ, ?_, rfl⟩
  intro t
  have ht := congrFun
    (Complex.isCoveringMap_exp.liftPath_lifts γ (Complex.log (f 0)) (by
      apply Subtype.ext
      exact (Complex.exp_log (hzero 0)).symm)) t
  exact congrArg Subtype.val ht

/-- Helper toward Proposition 5.16: a path has a unique logarithmic lift
increment, although its logarithmic lift can differ by a constant. -/
theorem d39_hasLiftIncrement_unique {a b w c d : ℂ} {g : Path a b}
    (hc : HasLiftIncrement g w c) (hd : HasLiftIncrement g w d) : c = d := by
  obtain ⟨φ, hφ, hiφ⟩ := hc
  obtain ⟨ψ, hψ, hiψ⟩ := hd
  let e : unitInterval → ℂ := fun t => φ t - ψ t
  have he : Continuous e := φ.continuous.sub ψ.continuous
  let T := AddSubgroup.zmultiples (2 * Real.pi * Complex.I : ℂ)
  let : DiscreteTopology T := NormedSpace.discreteTopology_zmultiples _
  have hemem (t : unitInterval) : e t ∈ T := by
    have heexp : Complex.exp (e t) = Complex.exp (0 : ℂ) := by
      dsimp [e]
      rw [Complex.exp_sub, hφ t, hψ t, Complex.exp_zero]
      apply div_self
      rw [← hφ t]
      exact Complex.exp_ne_zero _
    obtain ⟨k, hk⟩ := Complex.exp_eq_exp_iff_exists_int.mp heexp
    change e t ∈ AddSubgroup.zmultiples (2 * Real.pi * Complex.I : ℂ)
    rw [AddSubgroup.mem_zmultiples_iff]
    exact ⟨k, by simpa [zsmul_eq_mul, mul_comm] using hk.symm⟩
  let eT : unitInterval → T := fun t => ⟨e t, hemem t⟩
  have heTc : Continuous eT := Continuous.subtype_mk he hemem
  have he10 : e 1 = e 0 := congrArg Subtype.val
    (PreconnectedSpace.constant inferInstance heTc)
  dsimp [e] at he10
  rw [← hiφ, ← hiψ]
  linear_combination he10

/-- Helper toward Proposition 5.16: reversing a path negates its
logarithmic lift increment. -/
theorem d39_hasLiftIncrement_symm {a b w c : ℂ} {g : Path a b}
    (hc : HasLiftIncrement g w c) : HasLiftIncrement g.symm w (-c) := by
  obtain ⟨φ, hφ, hi⟩ := hc
  refine ⟨φ.comp (⟨unitInterval.symm, unitInterval.continuous_symm⟩ :
    C(unitInterval, unitInterval)), ?_, ?_⟩
  · intro t
    exact hφ (unitInterval.symm t)
  · change φ (unitInterval.symm 1) - φ (unitInterval.symm 0) = -c
    rw [unitInterval.symm_one, unitInterval.symm_zero, ← hi]
    ring

/-- Helper toward Proposition 5.16: a radial loop with an arbitrary middle
path avoiding the origin has, near the origin, winding `m + 1` in its strict
convex wedge and winding `m` outside the closed wedge. The integer is produced
by the residual loop, rather than assumed. -/
theorem d39_radialLoop_splitting
    (r : ℝ) (u v : ℂ) (hr : 0 < r) (hu : u ≠ 0) (hv : v ≠ 0)
    (huv : 0 < ccwTurn u v) (huvPi : ccwTurn u v < Real.pi)
    (P : Path ((r : ℂ) * u) ((r : ℂ) * v)) (hP : (0 : ℂ) ∉ Set.range P) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ m : ℤ, ∀ z : ℂ, ‖z‖ < δ →
      ((0 < (conj u * z).im ∧ 0 < (conj z * v).im) →
        HasWinding ((Path.segment (0 : ℂ) ((r : ℂ) * u)).trans
          (P.trans (Path.segment ((r : ℂ) * v) 0))) z (m + 1)) ∧
      (z ∉ d39ClosedWedge u v →
        HasWinding ((Path.segment (0 : ℂ) ((r : ℂ) * u)).trans
          (P.trans (Path.segment ((r : ℂ) * v) 0))) z m) := by
  let A := Path.segment (0 : ℂ) ((r : ℂ) * u)
  let B := Path.segment ((r : ℂ) * v) (0 : ℂ)
  let C := Path.segment ((r : ℂ) * u) ((r : ℂ) * v)
  let T := A.trans (C.trans B)
  let R := P.trans C.symm
  obtain ⟨ε, hε, hnear⟩ := d39_triangle_winding_near_zero r u v hr hu hv huv huvPi
  obtain ⟨η, hη, hchord⟩ := d39_triangle_chord_positive_near_zero r u v hr
    (d39_det_pos_of_ccwTurn_lt_pi u v hu hv huv huvPi)
  have hC0 : (0 : ℂ) ∉ Set.range C := by
    rw [Path.range_segment]
    intro hseg
    have heq := d39_leftSide_eq_zero_of_mem_segment hseg
    have hpos := hchord 0 (by simpa using hη)
    exact hpos.ne' heq
  have hR0 : (0 : ℂ) ∉ Set.range R := by
    simpa only [R, Path.trans_range, Path.symm_range, Set.mem_union, not_or] using
      And.intro hP hC0
  obtain ⟨m, hm⟩ := hasWinding_exists R 0 hR0
  obtain ⟨κ, hκ, hstable⟩ := hasWinding_stable_nearby R 0 m
    (fun t ht => hR0 ⟨t, ht⟩) hm
  have hPclosed : IsClosed (Set.range P) := (isCompact_range P.continuous).isClosed
  obtain ⟨ζ, hζ, hPnear⟩ := Metric.eventually_nhds_iff.mp
    (hPclosed.isOpen_compl.mem_nhds hP)
  let δ := min ε (min κ ζ)
  refine ⟨δ, lt_min hε (lt_min hκ hζ), m, ?_⟩
  have hcombine (z : ℂ) (hz : ‖z‖ < δ) (n : ℤ) (hT : HasWinding T z n) :
      HasWinding (A.trans (P.trans B)) z (m + n) := by
    have hzκ : dist z 0 < κ := by
      rw [dist_zero_right]
      exact lt_of_lt_of_le hz ((min_le_right ε (min κ ζ)).trans (min_le_left κ ζ))
    have hzζ : dist z 0 < ζ := by
      rw [dist_zero_right]
      exact lt_of_lt_of_le hz ((min_le_right ε (min κ ζ)).trans (min_le_right κ ζ))
    have hRz := hstable z hzκ
    have hzP : z ∉ Set.range P := hPnear hzζ
    have hzT := d39_not_mem_range_of_hasWinding hT
    simp only [T, Path.trans_range, Set.mem_union, not_or] at hzT
    obtain ⟨a, ha⟩ := d39_hasLiftIncrement_exists A hzT.1
    obtain ⟨b, hb⟩ := d39_hasLiftIncrement_exists B hzT.2.2
    obtain ⟨c, hc⟩ := d39_hasLiftIncrement_exists C hzT.2.1
    obtain ⟨p, hp⟩ := d39_hasLiftIncrement_exists P hzP
    have hiT : a + (c + b) = 2 * Real.pi * Complex.I * n :=
      d39_hasLiftIncrement_unique (hasLiftIncrement_trans ha (hasLiftIncrement_trans hc hb)) hT
    have hiR : p + -c = 2 * Real.pi * Complex.I * m :=
      d39_hasLiftIncrement_unique (hasLiftIncrement_trans hp (d39_hasLiftIncrement_symm hc)) hRz
    have hiL := hasLiftIncrement_trans ha (hasLiftIncrement_trans hp hb)
    have heq : a + (p + b) = 2 * Real.pi * Complex.I * ((m + n : ℤ) : ℂ) := by
      push_cast
      linear_combination hiT + hiR
    rw [heq] at hiL
    exact hiL
  intro z hz
  have hzε : ‖z‖ < ε := lt_of_lt_of_le hz (min_le_left _ _)
  constructor
  · intro hinside
    apply hcombine z hz 1
    exact ((hnear z hzε).1 hinside).2.2
  · intro hout
    have hzero := hcombine z hz 0 ((hnear z hzε).2 hout).2.2
    simpa only [add_zero] using hzero

/-- Helper toward Proposition 5.16: a polar point has oriented determinant
given by the sine of its lifted angular displacement. -/
theorem d39_det_polar (u : ℂ) (ρ θ : ℝ) :
    (conj u * ((ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))).im =
      ‖u‖ * ρ * Real.sin (θ - u.arg) := by
  simp only [Complex.mul_im, Complex.mul_re, Complex.conj_re, Complex.conj_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.exp_ofReal_mul_I_re,
    Complex.exp_ofReal_mul_I_im, zero_mul, add_zero, Real.sin_sub]
  rw [← Complex.norm_mul_cos_arg u, ← Complex.norm_mul_sin_arg u]
  ring

/-- Helper toward Proposition 5.16: points in the lifted open angular
wedge satisfy both strict oriented-side tests for its two rays. -/
theorem d39_openAngularWedge_det_pos
    (ε : ℝ) (u v z : ℂ) (hu : u ≠ 0) (hv : v ≠ 0)
    (hpi : ccwTurn u v < Real.pi)
    (hz : z ∈ d39OpenWedgeNearZero ε u.arg (ccwTurn u v)) :
    0 < (conj u * z).im ∧ 0 < (conj z * v).im := by
  obtain ⟨ρ, θ, hρ, hρε, hθ, hθv, rfl⟩ := hz
  constructor
  · rw [d39_det_polar]
    exact mul_pos (mul_pos (norm_pos_iff.mpr hu) hρ)
      (Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith))
  · have hswap :
        (conj ((ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)) * v).im =
          -(conj v * ((ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))).im := by
      simp only [Complex.mul_im, Complex.conj_re, Complex.conj_im]
      ring
    have hsin : Real.sin (u.arg + ccwTurn u v - θ) = Real.sin (v.arg - θ) := by
      unfold ccwTurn
      split_ifs
      · congr 1
        ring
      · rw [show u.arg + (v.arg - u.arg + 2 * Real.pi) - θ =
          (v.arg - θ) + 2 * Real.pi by ring, Real.sin_add_two_pi]
    have hpos : 0 < Real.sin (v.arg - θ) := by
      rw [← hsin]
      exact Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)
    rw [hswap, d39_det_polar]
    have heq : Real.sin (θ - v.arg) = -Real.sin (v.arg - θ) := by
      rw [← Real.sin_neg]
      congr 1
      ring
    rw [heq]
    nlinarith [mul_pos (mul_pos (norm_pos_iff.mpr hv) hρ) hpos]

/-- Helper toward Proposition 5.16: the triangle wedge has winding one
throughout a sufficiently small lifted open angular wedge, and winding zero
at every point outside its closed convex wedge. -/
theorem d39_wedgeLoop_winding_small_angular_wedge
    (r : ℝ) (u v : ℂ) (hr : 0 < r) (hu : u ≠ 0) (hv : v ≠ 0)
    (huv : 0 < ccwTurn u v) (hpi : ccwTurn u v < Real.pi) :
    ∃ ε : ℝ, 0 < ε ∧
      (∀ z ∈ d39OpenWedgeNearZero ε u.arg (ccwTurn u v),
        z ∉ (d39WedgePolyline r u v).image ∧
          HasWinding (d39WedgeLoop r u v) z 1) ∧
      (∀ z : ℂ, z ∉ d39ClosedWedge u v →
        z ∉ (d39WedgePolyline r u v).image ∧
          HasWinding (d39WedgeLoop r u v) z 0) := by
  obtain ⟨ε, hε, hnear⟩ := d39_triangle_winding_near_zero r u v hr hu hv huv hpi
  have hpoly : d39WedgePolyline r u v = d39TrianglePolyline r u v := ite_eq_left hpi
  have hwind (z : ℂ) (n : ℤ) : HasWinding (d39WedgeLoop r u v) z n ↔
      HasWinding ((d39TrianglePolyline r u v).toPath.cast rfl
        (d39TrianglePolyline_closed r u v)) z n := by
    change (∃ φ : C(unitInterval, ℂ),
      (∀ t, Complex.exp (φ t) = (d39WedgePolyline r u v).toPath t - z) ∧
        φ 1 - φ 0 = 2 * Real.pi * Complex.I * n) ↔ _
    rw [hpoly]
    rfl
  refine ⟨ε, hε, ?_, ?_⟩
  · intro z hz
    have hdet := d39_openAngularWedge_det_pos ε u v z hu hv hpi hz
    have hznorm : ‖z‖ < ε := by
      obtain ⟨ρ, θ, hρ, hρε, hθ, hθv, rfl⟩ := hz
      rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one,
        Complex.norm_real, Real.norm_eq_abs, abs_of_pos hρ]
      exact hρε
    obtain ⟨havoid, _, hw⟩ := (hnear z hznorm).1 hdet
    exact ⟨hpoly.symm ▸ havoid, (hwind z 1).2 hw⟩
  · intro z hz
    obtain ⟨havoid, _, hw⟩ := d39_triangle_exterior_hasWinding_zero r u v z hr.le hz
    exact ⟨hpoly.symm ▸ havoid, (hwind z 0).2 hw⟩

/-- Helper toward Proposition 5.16: paths with common endpoints in a convex
set avoiding the reference point have the same logarithmic lift increment. -/
theorem d39_hasLiftIncrement_eq_of_convex
    {a b w c d : ℂ} {g h : Path a b} (C : Set ℂ) (hC : Convex ℝ C)
    (hgC : Set.range g ⊆ C) (hhC : Set.range h ⊆ C) (hw : w ∉ C)
    (hg : HasLiftIncrement g w c) (hh : HasLiftIncrement h w d) : c = d := by
  have hzero := d39_hasWinding_zero_of_convex (g.trans h.symm) C hC (by
    rw [Path.trans_range, Path.symm_range]
    exact Set.union_subset hgC hhC) hw
  have hi := hasLiftIncrement_trans hg (d39_hasLiftIncrement_symm hh)
  have heq := d39_hasLiftIncrement_unique hi hzero
  simp only [Int.cast_zero, mul_zero] at heq
  linear_combination heq

/-- Helper toward Proposition 5.16: a point on a closed ray has zero
oriented determinant against that ray. -/
theorem d39_det_eq_zero_of_mem_selfWedge (u z : ℂ)
    (hz : z ∈ d39ClosedWedge u u) : (conj u * z).im = 0 := by
  obtain ⟨s, t, hs, ht, rfl⟩ := hz
  rw [d39_leftSide_origin_barycentric]
  simp only [Complex.mul_im, Complex.conj_re, Complex.conj_im]
  ring

/-- Helper toward Proposition 5.16: each boundary ray belongs to the closed
wedge, independently of its angular width. -/
theorem d39_selfWedge_subset_closedWedge (u v : ℂ) :
    d39ClosedWedge u u ⊆ d39ClosedWedge u v ∧
      d39ClosedWedge v v ⊆ d39ClosedWedge u v := by
  constructor
  · rintro z ⟨s, t, hs, ht, rfl⟩
    exact ⟨s + t, 0, add_nonneg hs ht, le_rfl, by push_cast; ring⟩
  · rintro z ⟨s, t, hs, ht, rfl⟩
    exact ⟨0, s + t, le_rfl, add_nonneg hs ht, by push_cast; ring⟩

/-- Helper toward Proposition 5.16: the local winding split also holds
when the two radial pieces are arbitrary continuous paths on their rays.
No parametrization or winding value for those pieces is assumed. -/
theorem d39_radialLoop_splitting_paths
    (u v : ℂ) (hu : u ≠ 0) (hv : v ≠ 0)
    (huv : 0 < ccwTurn u v) (huvPi : ccwTurn u v < Real.pi)
    (A : Path (0 : ℂ) u) (P : Path u v) (B : Path v (0 : ℂ))
    (hA : Set.range A ⊆ d39ClosedWedge u u)
    (hB : Set.range B ⊆ d39ClosedWedge v v)
    (hP : (0 : ℂ) ∉ Set.range P) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ m : ℤ, ∀ z : ℂ, ‖z‖ < δ →
      ((0 < (conj u * z).im ∧ 0 < (conj z * v).im) →
        HasWinding (A.trans (P.trans B)) z (m + 1)) ∧
      (z ∉ d39ClosedWedge u v → HasWinding (A.trans (P.trans B)) z m) := by
  have hsplit := d39_radialLoop_splitting 1 u v zero_lt_one hu hv huv huvPi
    (P.cast (by simp) (by simp)) (by simpa using hP)
  obtain ⟨δ, hδ, m, hlocal⟩ := hsplit
  let A₀ := Path.segment (0 : ℂ) u
  let B₀ := Path.segment v (0 : ℂ)
  have hA₀ : Set.range A₀ ⊆ d39ClosedWedge u u := by
    rw [Path.range_segment]
    exact (d39ClosedWedge_convex u u).segment_subset
      (d39_zero_mem_closedWedge u u) ⟨1, 0, by norm_num, le_rfl, by simp⟩
  have hB₀ : Set.range B₀ ⊆ d39ClosedWedge v v := by
    rw [Path.range_segment]
    exact (d39ClosedWedge_convex v v).segment_subset
      ⟨1, 0, by norm_num, le_rfl, by simp⟩ (d39_zero_mem_closedWedge v v)
  have hreplace (z : ℂ) (n : ℤ) (hzu : z ∉ d39ClosedWedge u u)
      (hzv : z ∉ d39ClosedWedge v v)
      (hstd : HasWinding (A₀.trans (P.trans B₀)) z n) :
      HasWinding (A.trans (P.trans B)) z n := by
    have hzstd := d39_not_mem_range_of_hasWinding hstd
    simp only [Path.trans_range, Set.mem_union, not_or] at hzstd
    obtain ⟨a, ha⟩ := d39_hasLiftIncrement_exists A (fun hx => hzu (hA hx))
    obtain ⟨a₀, ha₀⟩ := d39_hasLiftIncrement_exists A₀ hzstd.1
    obtain ⟨b, hb⟩ := d39_hasLiftIncrement_exists B (fun hx => hzv (hB hx))
    obtain ⟨b₀, hb₀⟩ := d39_hasLiftIncrement_exists B₀ hzstd.2.2
    obtain ⟨p, hp⟩ := d39_hasLiftIncrement_exists P hzstd.2.1
    have haa := d39_hasLiftIncrement_eq_of_convex _ (d39ClosedWedge_convex u u)
      hA hA₀ hzu ha ha₀
    have hbb := d39_hasLiftIncrement_eq_of_convex _ (d39ClosedWedge_convex v v)
      hB hB₀ hzv hb hb₀
    have hi := d39_hasLiftIncrement_unique
      (hasLiftIncrement_trans ha₀ (hasLiftIncrement_trans hp hb₀)) hstd
    have hnew := hasLiftIncrement_trans ha (hasLiftIncrement_trans hp hb)
    rw [haa, hbb, hi] at hnew
    exact hnew
  refine ⟨δ, hδ, m, ?_⟩
  intro z hz
  constructor
  · intro hinside
    apply hreplace z (m + 1)
    · intro hzu
      exact hinside.1.ne' (d39_det_eq_zero_of_mem_selfWedge u z hzu)
    · intro hzv
      have heq := d39_det_eq_zero_of_mem_selfWedge v z hzv
      have hswap : (conj z * v).im = -(conj v * z).im := by
        simp only [Complex.mul_im, Complex.conj_re, Complex.conj_im]
        ring
      rw [hswap, heq, neg_zero] at hinside
      exact lt_irrefl 0 hinside.2
    · simpa only [HasWinding, A₀, B₀, Path.trans_apply, Path.segment_apply, Path.cast_coe,
        Complex.ofReal_one, one_mul] using (hlocal z hz).1 hinside
  · intro hout
    apply hreplace z m (fun hx => hout ((d39_selfWedge_subset_closedWedge u v).1 hx))
      (fun hx => hout ((d39_selfWedge_subset_closedWedge u v).2 hx))
    simpa only [HasWinding, A₀, B₀, Path.trans_apply, Path.segment_apply, Path.cast_coe,
      Complex.ofReal_one, one_mul] using (hlocal z hz).2 hout

/-- Helper toward Proposition 5.16: a homeomorphism fixing zero and mapping
initial radial segments onto initial radial segments sends each sufficiently
small positive point to a positive point on the prescribed target ray. -/
theorem d39_radial_germ_image_positive
    (K : ℂ ≃ₜ ℂ) (hK0 : K 0 = 0) (u u' : ℂ) (hu : u ≠ 0)
    (hsegments : ∃ r s : ℝ, 0 < r ∧ 0 < s ∧
      K '' {z : ℂ | ∃ t : ℝ, 0 ≤ t ∧ t ≤ r ∧ z = (t : ℂ) * u} =
        {z : ℂ | ∃ t : ℝ, 0 ≤ t ∧ t ≤ s ∧ z = (t : ℂ) * u'}) :
    ∃ r : ℝ, 0 < r ∧ ∀ t : ℝ, 0 < t → t ≤ r →
      ∃ s : ℝ, 0 < s ∧ K ((t : ℂ) * u) = (s : ℂ) * u' := by
  obtain ⟨r, s, hr, hs, himage⟩ := hsegments
  refine ⟨r, hr, ?_⟩
  intro t ht htr
  have hmem : K ((t : ℂ) * u) ∈
      K '' {z : ℂ | ∃ q : ℝ, 0 ≤ q ∧ q ≤ r ∧ z = (q : ℂ) * u} :=
    ⟨(t : ℂ) * u, ⟨t, ht.le, htr, rfl⟩, rfl⟩
  rw [himage] at hmem
  obtain ⟨q, hq, hqs, heq⟩ := hmem
  have hq0 : q ≠ 0 := by
    intro hzero
    have hmapzero : K ((t : ℂ) * u) = K 0 := by simpa [hzero, hK0] using heq
    have htu := K.injective hmapzero
    exact (mul_ne_zero (Complex.ofReal_ne_zero.mpr ht.ne') hu) htu
  exact ⟨q, lt_of_le_of_ne hq hq0.symm, heq⟩

















































