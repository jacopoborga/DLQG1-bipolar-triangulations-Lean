/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. The literal local distance satisfies the strong
triangle inequality by transitivity of class agreement and restriction to the -/
theorem bsLocalDistance_ultrametric (S : RootedFramedBallSystem)
    (x y z : S.Object) :
    bsLocalDistance S x z ≤ max (bsLocalDistance S x y) (bsLocalDistance S y z) := by
  by_contra h
  have hlt : max (bsLocalDistance S x y) (bsLocalDistance S y z) <
      bsLocalDistance S x z := lt_of_not_ge h
  obtain ⟨ε, hmaxε, hεxz⟩ := exists_between hlt
  have hxyε : bsLocalDistance S x y < ε :=
    (le_max_left _ _).trans_lt hmaxε
  have hyzε : bsLocalDistance S y z < ε :=
    (le_max_right _ _).trans_lt hmaxε
  have hxyw : ∃ r, ∃ h : S.ballClass (r + 1) x = S.ballClass (r + 1) y,
      (2 : ℝ≥0∞)⁻¹ ^ (r + 1) < ε := by
    simpa only [bsLocalDistance, iInf_lt_iff] using hxyε
  have hyzw : ∃ r, ∃ h : S.ballClass (r + 1) y = S.ballClass (r + 1) z,
      (2 : ℝ≥0∞)⁻¹ ^ (r + 1) < ε := by
    simpa only [bsLocalDistance, iInf_lt_iff] using hyzε
  rcases hxyw with ⟨r, hxy, hrε⟩
  rcases hyzw with ⟨s, hyz, hsε⟩
  let q := min r s
  have hxyq : S.ballClass (q + 1) x = S.ballClass (q + 1) y :=
    localClass_eq_of_le S.ballClass S.restriction_compatible
      (show q + 1 ≤ r + 1 by omega) hxy
  have hyzq : S.ballClass (q + 1) y = S.ballClass (q + 1) z :=
    localClass_eq_of_le S.ballClass S.restriction_compatible
      (show q + 1 ≤ s + 1 by omega) hyz
  have hxzq : S.ballClass (q + 1) x = S.ballClass (q + 1) z := hxyq.trans hyzq
  have hqε : (2 : ℝ≥0∞)⁻¹ ^ (q + 1) < ε := by
    dsimp [q]
    by_cases hrs : r ≤ s
    · rw [min_eq_left hrs]
      exact hrε
    · have hsr : s ≤ r := by omega
      rw [min_eq_right hsr]
      exact hsε
  have hdistε : bsLocalDistance S x z < ε :=
    (bsLocalDistance_le_of_ballClass_eq S x z q hxzq).trans_lt hqε
  exact (lt_asymm hdistε hεxz)

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. The strong triangle inequality implies the usual -/
theorem bsLocalDistance_triangle (S : RootedFramedBallSystem)
    (x y z : S.Object) :
    bsLocalDistance S x z ≤ bsLocalDistance S x y + bsLocalDistance S y z := by
  calc
    bsLocalDistance S x z ≤ max (bsLocalDistance S x y) (bsLocalDistance S y z) :=
      bsLocalDistance_ultrametric S x y z
    _ ≤ bsLocalDistance S x y + bsLocalDistance S y z :=
      max_le (le_add_of_nonneg_right (by positivity))
        (le_add_of_nonneg_left (by positivity))

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. Open balls of the local distance are unions of
the basic positive-radius class cylinders. Source: -/
theorem bsLocalDistance_ball_eq (S : RootedFramedBallSystem) (x : S.Object)
    (ε : ℝ≥0∞) :
    {y | bsLocalDistance S x y < ε} =
      ⋃ r : {r : ℕ // (2 : ℝ≥0∞)⁻¹ ^ (r + 1) < ε},
        S.ballClass (r.val + 1) ⁻¹' {S.ballClass (r.val + 1) x} := by
  ext y
  simp only [mem_ofPred_eq, bsLocalDistance, iInf_lt_iff, mem_iUnion,
    mem_preimage, mem_singleton_iff]
  exact ⟨fun ⟨r, h, hr⟩ => ⟨⟨r, hr⟩, h.symm⟩,
    fun ⟨r, h⟩ => ⟨r.val, h.symm, r.property⟩⟩

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. Each centered positive-radius class cylinder is
an open ball of the literal local distance. Source: -/
theorem bsLocalDistance_ballClass_eq_ball (S : RootedFramedBallSystem)
    (r : ℕ) (x : S.Object) :
    S.ballClass (r + 1) ⁻¹' {S.ballClass (r + 1) x} =
      {y | bsLocalDistance S x y < (2 : ℝ≥0∞)⁻¹ ^ r} := by
  have hpow (m n : ℕ) :
      (2 : ℝ≥0∞)⁻¹ ^ m < (2 : ℝ≥0∞)⁻¹ ^ n ↔ n < m := by
    rw [← ENNReal.coe_inv_two, ← ENNReal.coe_pow, ← ENNReal.coe_pow,
      ENNReal.coe_lt_coe]
    exact pow_lt_pow_iff_right_of_lt_one₀ (by norm_num) (by norm_num)
  ext y
  simp only [mem_preimage, mem_singleton_iff, mem_ofPred_eq]
  constructor
  · intro h
    apply (show bsLocalDistance S x y < (2 : ℝ≥0∞)⁻¹ ^ r from ?_)
    apply (bsLocalDistance_le_of_ballClass_eq S x y r h.symm).trans_lt
    exact (hpow (r + 1) r).2 (by omega)
  · intro h
    have h' : ∃ s, ∃ heq : S.ballClass (s + 1) x = S.ballClass (s + 1) y,
        (2 : ℝ≥0∞)⁻¹ ^ (s + 1) < (2 : ℝ≥0∞)⁻¹ ^ r := by
      simpa only [bsLocalDistance, iInf_lt_iff] using h
    rcases h' with ⟨s, heq, hs⟩
    have hrs : r + 1 ≤ s + 1 := Nat.succ_le_iff.mpr ((hpow (s + 1) r).mp hs)
    exact (localClass_eq_of_le S.ballClass S.restriction_compatible hrs heq).symm

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. The topology generated by local-distance open
balls is exactly the compatible positive-radius local-class topology. Its
basic opens are the centered ball-class agreement sets. Source: -/
@[expose, instance_reducible] def bsLocalDistanceTopology (S : RootedFramedBallSystem) :
    TopologicalSpace S.Object :=
  TopologicalSpace.generateFrom
    {s | ∃ x ε, s = {y | bsLocalDistance S x y < ε}}

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. The topology generated by the literal local
distance agrees with `localClassTopology S.ballClass`. Source: -/
theorem bsLocalDistanceTopology_eq_localClassTopology
    (S : RootedFramedBallSystem) :
    bsLocalDistanceTopology S = localClassTopology S.ballClass := by
  apply le_antisymm
  · let := bsLocalDistanceTopology S
    apply le_generateFrom
    rintro t ⟨r, c, rfl⟩
    cases r with
    | zero =>
        have hcover : S.ballClass 0 ⁻¹' {c} =
            ⋃ x : {x : S.Object // S.ballClass 0 x = c},
              S.ballClass 1 ⁻¹' {S.ballClass 1 x.1} := by
          ext y
          simp only [mem_preimage, mem_singleton_iff, mem_iUnion, Subtype.exists]
          constructor
          · intro hy
            exact ⟨y, hy, rfl⟩
          · rintro ⟨x, hx, hxy⟩
            have h0 := S.restriction_compatible 0 y x hxy
            exact h0.trans hx
        rw [hcover]
        exact isOpen_iUnion fun x => by
          rw [bsLocalDistance_ballClass_eq_ball]
          exact TopologicalSpace.GenerateOpen.basic _
            ⟨x.1, 1, by norm_num⟩
    | succ r =>
        rcases eq_empty_or_nonempty
            (S.ballClass (r + 1) ⁻¹' {c}) with h | ⟨x, hx⟩
        · rw [h]
          exact isOpen_empty
        · have hx' : S.ballClass (r + 1) x = c := hx
          rw [← hx', bsLocalDistance_ballClass_eq_ball]
          exact TopologicalSpace.GenerateOpen.basic _
            ⟨x, (2 : ℝ≥0∞)⁻¹ ^ r, rfl⟩
  · let := localClassTopology S.ballClass
    apply le_generateFrom
    rintro t ⟨x, ε, rfl⟩
    rw [bsLocalDistance_ball_eq]
    exact isOpen_iUnion fun r =>
      isOpen_localCylinder S.ballClass (r.val + 1) (S.ballClass (r.val + 1) x)

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
