/-! # Candidate provider for Definition 3.8 (`def-bs-topology`)


Clause dictionary for this provider:

* Source lines 229–230 take vertices within undirected graph distance at most
  `r` from the initial root endpoint, then retain induced directed edges and
  faces with all boundary vertices in that set. local topology fixes positive radii and
  all-geometric distance, traversing present and missing edges.
* local topology retains every induced geometric edge with its present/missing tag and
  incidence, present orientations, inherited plane structure, original
  contained faces, and the ordered root mark. `FramedBall` is the candidate
  carrier for these data; constructing the source ball as a `FramedBall` is an
  outstanding geometric obligation.
* Source line 233 compares balls by directed planar-map isomorphism. local topology
  requires isomorphisms to preserve tags, incidence, plane orientation, faces,
  and the ordered root mark; `FramedBallClass` is the class carrier.
* Source lines 233–235 define the distance as the infimum of `2⁻ʳ` over
  agreeing positive-radius balls. `bsLocalDistance` uses exactly those weights
  with source radius `r + 1`.
* The topology generated by these classes is represented by the local-class
  topology, and `def_3_9_bs_topology_provider` states convergence in law iff
  every positive-radius class push-forward converges.

`RootedFramedBallSystem` takes coherent positive-radius classes as data because
the canonical class restriction is still in progress. It does not construct
balls from infinite maps or discharge root, face, window-capture, or law
identification obligations. -/

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. A carrier of rooted objects with their
positive-radius `FramedBallClass` sequence and the restriction compatibility
needed by the local topology criterion. Index `r` represents source radius -/
structure RootedFramedBallSystem where
  Object : Type
  ballClass : ℕ → Object → FramedBallClass
  restriction_compatible : ∀ r x y,
    ballClass (r + 1) x = ballClass (r + 1) y → ballClass r x = ballClass r y

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. The literal local topology local distance, as an extended
nonnegative real infimum over positive source radii. An empty agreement set
therefore has distance `⊤`, matching the printed infimum convention. Source: -/
@[expose] noncomputable def bsLocalDistance (S : RootedFramedBallSystem)
    (x y : S.Object) : ℝ≥0∞ :=
  ⨅ r : ℕ, ⨅ (_ : S.ballClass (r + 1) x = S.ballClass (r + 1) y),
    (2 : ℝ≥0∞)⁻¹ ^ (r + 1)

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. Agreement at source radius `r + 1` bounds the
literal local distance by its source weight. Source: -/
theorem bsLocalDistance_le_of_ballClass_eq (S : RootedFramedBallSystem)
    (x y : S.Object) (r : ℕ)
    (h : S.ballClass (r + 1) x = S.ballClass (r + 1) y) :
    bsLocalDistance S x y ≤ (2 : ℝ≥0∞)⁻¹ ^ (r + 1) := by
  unfold bsLocalDistance
  exact iInf_le_of_le r (iInf_le_of_le h le_rfl)

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. The closed source-radius bound characterizes
agreement of the corresponding positive-radius framed-ball classes. Source: -/
theorem bsLocalDistance_le_iff_ballClass_eq (S : RootedFramedBallSystem)
    (x y : S.Object) (r : ℕ) :
    bsLocalDistance S x y ≤ (2 : ℝ≥0∞)⁻¹ ^ (r + 1) ↔
      S.ballClass (r + 1) x = S.ballClass (r + 1) y := by
  constructor
  · intro h
    by_contra hne
    have hno (s : ℕ) (hrs : r ≤ s)
        (heq : S.ballClass (s + 1) x = S.ballClass (s + 1) y) : False := by
      apply hne
      exact localClass_eq_of_le S.ballClass S.restriction_compatible
        (show r + 1 ≤ s + 1 by omega) heq
    have hpow (m n : ℕ) :
        (2 : ℝ≥0∞)⁻¹ ^ m < (2 : ℝ≥0∞)⁻¹ ^ n ↔ n < m := by
      rw [← ENNReal.coe_inv_two, ← ENNReal.coe_pow, ← ENNReal.coe_pow,
        ENNReal.coe_lt_coe]
      exact pow_lt_pow_iff_right_of_lt_one₀ (by norm_num) (by norm_num)
    have hsmall : (2 : ℝ≥0∞)⁻¹ ^ (r + 1) < (2 : ℝ≥0∞)⁻¹ ^ r :=
      (hpow (r + 1) r).2 (by omega)
    have hbound : (2 : ℝ≥0∞)⁻¹ ^ r ≤ bsLocalDistance S x y := by
      unfold bsLocalDistance
      apply le_iInf
      intro s
      apply le_iInf
      intro heq
      by_cases hrs : r ≤ s
      · exact (hno s hrs heq).elim
      · have hs : s + 1 ≤ r := by omega
        exact pow_le_pow_right_of_le_one'
          (ENNReal.inv_le_one.2 ENNReal.one_lt_two.le) hs
    have hgt : (2 : ℝ≥0∞)⁻¹ ^ (r + 1) < bsLocalDistance S x y :=
      hsmall.trans_le hbound
    change bsLocalDistance S x y ≤ (2 : ℝ≥0∞)⁻¹ ^ (r + 1) at h
    exact (not_le_of_gt hgt) h
  · exact bsLocalDistance_le_of_ballClass_eq S x y r

/-- Candidate provider toward Definition 3.8 (def-bs-topology, local topology ruling);
not yet a counted paper result. The literal local distance vanishes on the
diagonal because all positive-radius classes agree and the weights tend to zero. -/
theorem bsLocalDistance_self (S : RootedFramedBallSystem) (x : S.Object) :
    bsLocalDistance S x x = 0 := by
  have hpow : Tendsto (fun r : ℕ => (2 : ℝ≥0∞)⁻¹ ^ (r + 1)) atTop (𝓝 0) := by
    have h : Tendsto (fun n : ℕ => (2 : ℝ≥0∞)⁻¹ ^ n) atTop (𝓝 0) :=
      ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one
        (show (2 : ℝ≥0∞)⁻¹ < 1 by norm_num)
    exact h.comp (tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id)
  apply le_antisymm
  · apply le_of_tendsto_of_tendsto' tendsto_const_nhds hpow
    intro r
    exact bsLocalDistance_le_of_ballClass_eq S x x r rfl
  · exact bot_le

