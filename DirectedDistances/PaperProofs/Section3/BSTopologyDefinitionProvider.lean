theorem def_3_9_bs_topology_provider (S : RootedFramedBallSystem) :
    letI : TopologicalSpace FramedBallClass := ⊥
    letI : DiscreteTopology FramedBallClass := ⟨rfl⟩
    letI := bsLocalDistanceTopology S
    letI := borel S.Object
    letI : BorelSpace S.Object := ⟨rfl⟩
    ∀ {ι : Type*} {L : Filter ι} [L.IsCountablyGenerated]
      {μs : ι → ProbabilityMeasure S.Object} {μ : ProbabilityMeasure S.Object},
      Tendsto μs L (𝓝 μ) ↔
        ∀ r, Tendsto (fun i => (μs i).map (S.ballClass r)) L
          (𝓝 ((μ.map (S.ballClass r)))) := by
  let : TopologicalSpace FramedBallClass := ⊥
  let : DiscreteTopology FramedBallClass := ⟨rfl⟩
  have htop := bsLocalDistanceTopology_eq_localClassTopology S
  rw [htop]
  intro ι L hL μs μ
  exact (tendsto_iff_localClass_map S.ballClass S.restriction_compatible)

