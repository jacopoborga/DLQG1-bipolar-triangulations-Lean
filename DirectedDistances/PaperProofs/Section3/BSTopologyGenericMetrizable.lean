universe u v

/-- Helper toward Proposition 5.9 (prop-uihbot-sym) and Theorem 1.7(iv); not a paper result.
The generic local distance is a pseudo extended metric; the imported ultrametric
inequality follows from compatible restriction of ball classes. -/
@[expose, instance_reducible] noncomputable def bsLocalDistancePseudoEMetricSpaceGeneric
    {C : Type v} [Countable C] (S : RootedBallSystem C) :
    PseudoEMetricSpace S.Object :=
  PseudoEMetricSpace.ofEDist (bsLocalDistanceGeneric S)
    (bsLocalDistance_selfGeneric S)
    (bsLocalDistance_symmGeneric S)
    (bsLocalDistance_triangleGeneric S)

/-- Helper toward Proposition 5.9 (prop-uihbot-sym) and Theorem 1.7(iv); not a paper result.
Local instance for proofs using the generic local distance. -/
local instance bsLocalDistancePseudoEMetricSpaceGenericInstance
    {C : Type v} [Countable C] (S : RootedBallSystem C) :
    PseudoEMetricSpace S.Object := bsLocalDistancePseudoEMetricSpaceGeneric S

/-- Helper toward Proposition 5.9 (prop-uihbot-sym) and Theorem 1.7(iv); not a paper result.
The topology generated by strict local-distance balls is the canonical pseudo-emetric topology. -/
theorem bsLocalDistanceTopology_eq_pseudoEMetricTopologyGeneric
    {C : Type v} [Countable C] (S : RootedBallSystem C) :
    letI : PseudoEMetricSpace S.Object := bsLocalDistancePseudoEMetricSpaceGeneric S
    bsLocalDistanceTopologyGeneric S = (inferInstance : TopologicalSpace S.Object) := by
  apply TopologicalSpace.ext_iff.mpr
  intro (t : Set S.Object)
  change TopologicalSpace.GenerateOpen
      {s | ∃ x ε, s = {y | bsLocalDistanceGeneric S x y < ε}} t ↔
      IsOpen t
  constructor
  · intro ht
    induction ht with
    | basic s hs =>
        rcases hs with ⟨x, ε, rfl⟩
        change IsOpen {y | edist x y < ε}
        simpa only [Metric.eball, edist_comm] using
          (Metric.isOpen_eball (x := x) (r := ε))
    | univ => exact isOpen_univ
    | inter _ _ _ _ hs ht => exact hs.inter ht
    | sUnion _ _ hs => exact isOpen_sUnion hs
  · intro ht
    classical
    let ε (x : {x : S.Object // x ∈ t}) : ℝ≥0∞ :=
      Classical.choose (EMetric.isOpen_iff.mp ht (x : S.Object) x.property)
    have hε (x : {x : S.Object // x ∈ t}) : 0 < ε x :=
      (Classical.choose_spec (EMetric.isOpen_iff.mp ht (x : S.Object) x.property)).1
    have hball (x : {x : S.Object // x ∈ t}) :
        {y | bsLocalDistanceGeneric S (x : S.Object) y < ε x} ⊆ t := by
      intro y hy
      change edist (x : S.Object) y < ε x at hy
      apply (Classical.choose_spec
        (EMetric.isOpen_iff.mp ht (x : S.Object) x.property)).2
      change edist y (x : S.Object) < ε x
      rw [edist_comm]
      exact hy
    have hdecomp : t = ⋃₀ Set.range
        (fun x : {x : S.Object // x ∈ t} =>
          {y | bsLocalDistanceGeneric S (x : S.Object) y < ε x}) := by
      ext y
      constructor
      · intro hy
        apply Set.mem_sUnion.mpr
        let x₀ : {x : S.Object // x ∈ t} := ⟨y, hy⟩
        refine ⟨{z | bsLocalDistanceGeneric S (x₀ : S.Object) z < ε x₀}, ?_, ?_⟩
        · exact ⟨x₀, rfl⟩
        · change bsLocalDistanceGeneric S (x₀ : S.Object) y < ε x₀
          rw [bsLocalDistance_selfGeneric]
          exact hε x₀
      · intro hy
        rcases Set.mem_sUnion.mp hy with ⟨s, hs, hys⟩
        rcases Set.mem_range.mp hs with ⟨x, rfl⟩
        exact hball x hys
    rw [hdecomp]
    apply TopologicalSpace.GenerateOpen.sUnion
    intro s hs
    rcases Set.mem_range.mp hs with ⟨x, rfl⟩
    apply TopologicalSpace.GenerateOpen.basic
    exact ⟨(x : S.Object), ε x, rfl⟩

/-- Helper toward Proposition 5.9 (prop-uihbot-sym) and Theorem 1.7(iv); not a paper result.
The helper topology is pseudometrizable by the extended local distance. -/
theorem bsLocalDistanceTopology_pseudoMetrizableGeneric
    {C : Type v} [Countable C] (S : RootedBallSystem C) :
    @TopologicalSpace.PseudoMetrizableSpace S.Object
      (bsLocalDistanceTopologyGeneric S) := by
  rw [bsLocalDistanceTopology_eq_pseudoEMetricTopologyGeneric]
  exact inferInstance

/-- Helper toward Proposition 5.9 (prop-uihbot-sym) and Theorem 1.7(iv); not a paper result.
The helper topology is pseudometrizable by the extended local distance. -/
local instance rootedPlanarMapLawTopology : TopologicalSpace RootedLocallyFinitePlanarMap :=
  bsLocalDistanceTopologyGeneric rootedLocallyFiniteFacedBallSystem

/-- Helper toward Proposition 5.9 (prop-uihbot-sym) and Theorem 1.7(iv); not a paper result. -/
local instance rootedPlanarMapLawPseudoMetrizable :
    TopologicalSpace.PseudoMetrizableSpace RootedLocallyFinitePlanarMap :=
  bsLocalDistanceTopology_pseudoMetrizableGeneric rootedLocallyFiniteFacedBallSystem

/-- Helper toward Proposition 5.9 (prop-uihbot-sym) and Theorem 1.7(iv); not a paper result.
The helper topology on rooted locally finite planar maps has
`HasOuterApproxClosed`. -/
theorem rootedPlanarMapLaw_hasOuterApproxClosed :
    @HasOuterApproxClosed RootedLocallyFinitePlanarMap
      (bsLocalDistanceTopologyGeneric rootedLocallyFiniteFacedBallSystem) := by
  infer_instance

end

