module

public import DirectedDistances.KMSW.M0CutData

/-! Supporting lemmas for paper labels `defn-future-map` (see CORRESPONDENCE.md). -/

/-! # Combinatorial clauses of Definition 1.3

The left side here is the independently defined rotation-system side
`m0CutLeftDarts`, generated by following left faces and crossing non-interface
edges. Its identification with the geometric left side is a separate obligation.
The leftmost incoming convention for beta_0^L is the recorded ledger D18 convention.

Missing beta_0^L edges retain their geometric identities and both darts. They
are excluded from the present edge set and have no orientation. Thus the edge
selection equivalence below concerns present edges, not geometric edges.

This file is a helper, not a candidate anchor for the complete definition.
The remaining obligations are to identify the rotation-system faces with the
complementary components in the realized whole-plane drawing (S3), identify this
generated left side with the geometric left side of the drawn interface, and
transport the boundary and inherited rotation into that same realization. The
source's infinite acyclic triangulation assertion is not asserted here as a
property of that realized submap. Existing drawing results are not imported or -/

public section
namespace DirectedDistances.PaperProofs.Section1

open MeasureTheory DirectedDistances.KMSW DirectedDistances.PlanarMap

section Combinatorial

variable {W : ℤ → Fin 3} {H : WholePlaneRotationHypothesis W}
    (D : M0CutData W H)
    (h : BoundaryHitWitnesses (shiftedStream W 0))
    (hLL : ∀ k : ℤ, k ≤ 0 → wholePlaneEdgePresent W
      (wholePlaneEdgeι W 0
        (kmswLLCreatedEdge (shiftedStream W 0)
          (boundaryHitTime (shiftedStream W 0) h (k - 1)))))

include h hLL



theorem futureMap_seam_iff (e : WholePlaneEdge W) :
    D.seam e ↔ e = m0CutLambdaZero W ∨
      e ∈ Set.range D.betaR.edge ∨ e ∈ Set.range D.betaL.edge := by
  constructor
  · rintro (hr | ⟨P, hP, n, hn⟩ | ⟨P, n, hn⟩)
    · exact Or.inl hr
    · have he := (m0Cut_betaR_unique W H P D.betaR hP D.betaR_start).2
      exact Or.inr (Or.inl ⟨n, (congrFun he n).symm.trans hn⟩)
    · have he := (m0Cut_betaL_unique W H h hLL P D.betaL).2
      exact Or.inr (Or.inr ⟨n, (congrFun he n).symm.trans hn⟩)
  · rintro (hr | ⟨n, hn⟩ | ⟨n, hn⟩)
    · exact Or.inl hr
    · exact Or.inr (Or.inl ⟨D.betaR, D.betaR_start, n, hn⟩)
    · exact Or.inr (Or.inr ⟨D.betaL, n, hn⟩)

omit h hLL in


theorem futureMap_seam_mem_edges {e : WholePlaneEdge W} (he : D.seam e) :
    e ∈ D.edges :=
  ⟨(e, false), ⟨e, he, Relation.ReflTransGen.refl⟩, rfl⟩



theorem futureMap_missing_iff_betaL {e : WholePlaneEdge W} (he : e ∈ D.edges) :
    D.missing e ↔ e ∈ Set.range D.betaL.edge := by
  constructor
  · intro hm
    rw [D.edges_eq h hLL] at he
    obtain ⟨a, rfl⟩ := he
    have hn := (D.missing_eq h hLL a).mp hm
    have hevent := (m0Cut_not_present_iff_eventually_LL (shiftedStream W 0) h a).mp hn
    have hr : a ∈ Set.range (fun j : ℕ =>
        kmswLLCreatedEdge (shiftedStream W 0)
          (boundaryHitTime (shiftedStream W 0) h (-((j : ℤ) + 1)))) := by
      rw [← kmswRunEventuallyLL_eq_range (shiftedStream W 0) h]
      exact hevent
    obtain ⟨j, hj⟩ := hr
    refine ⟨j, ?_⟩
    rw [m0Cut_betaL_edges W H h hLL D.betaL j]
    have hi : -(j : ℤ) - 1 = -((j : ℤ) + 1) := by omega
    rw [hi]
    exact congrArg (wholePlaneEdgeι W 0) hj
  · rintro ⟨j, hj⟩
    exact Or.inl ⟨D.betaL, j, hj⟩



theorem futureMap_edges_ambient_present {e : WholePlaneEdge W} (he : e ∈ D.edges) :
    wholePlaneEdgePresent W e := by
  classical
  by_cases hm : D.missing e
  · obtain ⟨j, rfl⟩ := (futureMap_missing_iff_betaL D h hLL he).mp hm
    exact (D.betaL.leftmost j).1
  · by_contra hn
    exact hm (Or.inr hn)



theorem futureMap_betaR_not_missing (n : ℕ) : ¬ D.missing (D.betaR.edge n) := by
  have he : D.betaR.edge n = wholePlaneEdgeι W 0
      (boundaryOuterEdge (shiftedStream W 0) h ((n : ℤ) + 1)) := by
    rw [m0Cut_betaR_edges W H h D.betaR D.betaR_start n,
      boundaryOuterEdge_of_positive (shiftedStream W 0) h (by omega)]
    have hi : ((n : ℤ) + 1).toNat = n + 1 := by omega
    rw [hi]
  rw [he, D.missing_eq h hLL]
  exact not_not_intro
    ((boundaryOuterEdge_endpoints (shiftedStream W 0) h ((n : ℤ) + 1)).2.2.1
      (by omega))




theorem futureMap_present_edges_iff (e : WholePlaneEdge W) :
    (e ∈ D.edges ∧ ¬ D.missing e) ↔
      (e ∈ D.edges ∧ ¬ D.seam e) ∨ e = m0CutLambdaZero W ∨
        e ∈ Set.range D.betaR.edge := by
  constructor
  · rintro ⟨he, hm⟩
    by_cases hs : D.seam e
    · rcases (futureMap_seam_iff D h hLL e).mp hs with hr | hR | hL
      · exact Or.inr (Or.inl hr)
      · exact Or.inr (Or.inr hR)
      · exact (hm ((futureMap_missing_iff_betaL D h hLL he).mpr hL)).elim
    · exact Or.inl ⟨he, hs⟩
  · rintro (⟨he, hs⟩ | rfl | ⟨n, rfl⟩)
    · refine ⟨he, fun hm => hs ?_⟩
      exact (futureMap_seam_iff D h hLL e).mpr
        (Or.inr (Or.inr ((futureMap_missing_iff_betaL D h hLL he).mp hm)))
    · exact ⟨futureMap_seam_mem_edges D (Or.inl rfl), (D.root_eq h hLL).2.2.2.2.1⟩
    · refine ⟨futureMap_seam_mem_edges D ?_, futureMap_betaR_not_missing D h hLL n⟩
      exact (futureMap_seam_iff D h hLL _).mpr (Or.inr (Or.inl ⟨n, rfl⟩))



theorem futureMap_tail_iff (d : WholePlaneDart W) (hd : d ∈ D.darts) :
    D.tail d ↔ wholePlaneDartTail W d ∧ d.1 ∉ Set.range D.betaL.edge := by
  change (wholePlaneDartTail W d ∧ ¬ D.missing d.1) ↔ _
  rw [futureMap_missing_iff_betaL D h hLL hd]



theorem futureMap_label_range :
    Set.range D.x = {v | ∃ e, D.seam e ∧
      (wholePlaneEdgeWest W e = v ∨ wholePlaneEdgeEast W e = v)} := by
  ext v
  constructor
  · rintro ⟨k, rfl⟩
    have ho := m0Cut_boundaryLabel_consecutive W H h hLL k (D.x_label k)
      (D.x_label (k + 1))
    exact ⟨_, ho.1, Or.inl ho.2.1⟩
  · rintro ⟨e, he, hv⟩
    obtain ⟨a, ha, hae⟩ := (m0Cut_seamEdge_iff W H h hLL e).mp he
    rw [← boundaryOuterEdge_range (shiftedStream W 0) h] at ha
    obtain ⟨k, rfl⟩ := ha
    have ho := m0Cut_boundaryLabel_consecutive W H h hLL k (D.x_label k)
      (D.x_label (k + 1))
    rw [← hae] at hv
    rcases hv with hw | ht
    · exact ⟨k, ho.2.1.symm.trans hw⟩
    · exact ⟨k + 1, ho.2.2.symm.trans ht⟩



theorem futureMap_label_mem_vertices (k : ℤ) :
    D.x k ∈ m0CutLeftVertices W H D.seam := by
  rw [m0Cut_leftVertices_eq_runZero W H h D.seam (m0Cut_seamEdge_iff W H h hLL),
    D.x_eq h hLL k]
  exact Set.mem_range_self _



theorem futureMap_rotation_iff (d : ℕ × Bool) (a : WholePlaneDart W) :
    D.IsRot (wholePlaneDartι W 0 d) a ↔
      a = wholePlaneDartι W 0 ((kmswInfRot (shiftedStream W 0) (H.1 0)).symm d) := by
  constructor
  · intro ha
    exact D.rot_functional ha (D.rot_eq h hLL d)
  · rintro rfl
    exact D.rot_eq h hLL d

end Combinatorial






theorem futureMap_combinatorial_characterization_ae :
    ∀ᵐ W ∂RandomWalk.wholePlaneIIDCodeMeasure,
      ∃ H : WholePlaneRotationHypothesis W,
      ∃ h : BoundaryHitWitnesses (shiftedStream W 0),
      ∃ hLL : ∀ k : ℤ, k ≤ 0 → wholePlaneEdgePresent W
        (wholePlaneEdgeι W 0
          (kmswLLCreatedEdge (shiftedStream W 0)
            (boundaryHitTime (shiftedStream W 0) h (k - 1)))),
      let D := m0CutData W H h hLL
      (∀ e, D.seam e ↔ e = m0CutLambdaZero W ∨
        e ∈ Set.range D.betaR.edge ∨ e ∈ Set.range D.betaL.edge) ∧
      (m0CutLeftVertices W H D.seam = Set.range (wholePlaneVertexι W 0)) ∧
      Function.Injective (wholePlaneVertexι W 0) ∧
      D.edges = Set.range (wholePlaneEdgeι W 0) ∧
      Function.Injective (wholePlaneEdgeι W 0) ∧
      D.darts = Set.range (wholePlaneDartι W 0) ∧
      (∀ e, D.seam e → e ∈ D.edges) ∧
      (∀ e, e ∈ D.edges → (D.missing e ↔ e ∈ Set.range D.betaL.edge)) ∧
      (∀ e, e ∈ D.edges → wholePlaneEdgePresent W e) ∧
      (∀ e, (e ∈ D.edges ∧ ¬ D.missing e) ↔
        (e ∈ D.edges ∧ ¬ D.seam e) ∨ e = m0CutLambdaZero W ∨
          e ∈ Set.range D.betaR.edge) ∧
      (∀ d, d ∈ D.darts →
        (D.tail d ↔ wholePlaneDartTail W d ∧ d.1 ∉ Set.range D.betaL.edge)) ∧
      (∀ e, D.missing e → ¬ D.tail (e, false) ∧ ¬ D.tail (e, true)) ∧
      (D.rootDart = wholePlaneDartι W 0 futureMapRootDart ∧
        wholePlaneEdgeWest W D.rootDart.1 = D.x 0 ∧
        wholePlaneEdgeEast W D.rootDart.1 = D.x 1 ∧
        wholePlaneEdgePresent W D.rootDart.1 ∧
        ¬ D.missing D.rootDart.1 ∧ D.tail D.rootDart) ∧
      Function.Injective D.x ∧
      (Set.range D.x = {v | ∃ e, D.seam e ∧
        (wholePlaneEdgeWest W e = v ∨ wholePlaneEdgeEast W e = v)}) ∧
      (∀ k, D.x k ∈ m0CutLeftVertices W H D.seam) ∧
      (∀ k, D.x k = wholePlaneVertexι W 0 (boundaryVertex (shiftedStream W 0) h k)) ∧
      (∀ k, wholePlaneEdgeWest W
          (wholePlaneEdgeι W 0 (boundaryOuterEdge (shiftedStream W 0) h k)) = D.x k ∧
        wholePlaneEdgeEast W
          (wholePlaneEdgeι W 0 (boundaryOuterEdge (shiftedStream W 0) h k)) = D.x (k + 1)) ∧
      (∀ d, wholePlaneDartFlip W (wholePlaneDartι W 0 d) =
        wholePlaneDartι W 0 (futureMapEdgeInv d)) ∧
      (∀ d, wholePlaneDartVertex W (wholePlaneDartι W 0 d) =
        wholePlaneVertexι W 0 (kmswLimitDartVertex (shiftedStream W 0) d)) ∧
      (∀ d a, D.IsRot (wholePlaneDartι W 0 d) a ↔
        a = wholePlaneDartι W 0 ((kmswInfRot (shiftedStream W 0) (H.1 0)).symm d)) := by
  apply wholePlaneIID_ae_leftBoundary_leftmost_chain.mono
  intro W hW
  obtain ⟨H, hRuns⟩ := hW
  obtain ⟨h, hLL, _⟩ := hRuns 0
  let D := m0CutData W H h hLL
  refine ⟨H, h, hLL, futureMap_seam_iff D h hLL,
    m0Cut_leftVertices_eq_runZero W H h D.seam (m0Cut_seamEdge_iff W H h hLL),
    wholePlaneVertexι_injective W 0, D.edges_eq h hLL, wholePlaneEdgeι_injective W 0,
    D.darts_eq h hLL, fun _ he => futureMap_seam_mem_edges D he,
    fun _ he => futureMap_missing_iff_betaL D h hLL he,
    fun _ he => futureMap_edges_ambient_present D h hLL he,
    futureMap_present_edges_iff D h hLL, futureMap_tail_iff D h hLL,
    ?_, D.root_eq h hLL, ?_, futureMap_label_range D h hLL,
    futureMap_label_mem_vertices D h hLL, D.x_eq h hLL, ?_,
    D.flip_eq, wholePlaneDartVertex_ι W 0, futureMap_rotation_iff D h hLL⟩
  · intro e he
    exact ⟨fun ht => ht.2 he, fun ht => ht.2 he⟩
  · intro k l hkl
    apply boundaryVertex_injective (shiftedStream W 0) h
    apply wholePlaneVertexι_injective W 0
    rw [← D.x_eq h hLL k, ← D.x_eq h hLL l]
    exact hkl
  · intro k
    exact (m0Cut_boundaryLabel_consecutive W H h hLL k (D.x_label k)
      (D.x_label (k + 1))).2

end DirectedDistances.PaperProofs.Section1
