module

public import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-! # Cumulative truncation codes

Helpers toward Proposition 4.7 (prop-thin-ind); not a paper result. Source context:
of its finite truncations; the level-`s` code keeps the truncations of index `≤ s`. -/

public section
namespace DirectedDistances.PaperProofs.Section4

open MeasureTheory

variable {Q γ C : Type*}

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
The level-`s` cumulative code of `q`: truncations of index `≤ s`, default `d` afterwards. -/
@[expose] def cumulativeCode (τ : ℕ → Q → γ) (d : γ) (s : ℕ) (q : Q) : ℕ → γ :=
  fun i => if i ≤ s then τ i q else d

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
Truncate a code to indices `≤ s`, filling with the default `d`. -/
@[expose] def truncateCode (d : γ) (s : ℕ) (f : ℕ → γ) : ℕ → γ :=
  fun i => if i ≤ s then f i else d

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
`truncateCode` is measurable for the product σ-algebra. -/
theorem measurable_truncateCode [MeasurableSpace γ] (d : γ) (s : ℕ) :
    Measurable (truncateCode d s) := by
  refine measurable_pi_iff.2 fun i => ?_
  by_cases h : i ≤ s
  · simpa [truncateCode, h] using measurable_pi_apply i
  · simp only [truncateCode, h, ite_false]
    exact measurable_const

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
`cumulativeCode` is measurable when each truncation is. -/
theorem measurable_cumulativeCode [MeasurableSpace Q] [MeasurableSpace γ]
    {τ : ℕ → Q → γ} (d : γ) (hτ : ∀ i, Measurable (τ i))
    (s : ℕ) : Measurable (cumulativeCode τ d s) := by
  refine measurable_pi_iff.2 fun i => ?_
  by_cases h : i ≤ s
  · simpa [cumulativeCode, h] using hτ i
  · simp only [cumulativeCode, h, ite_false]
    exact measurable_const

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
Lower-level codes are truncations of higher-level codes. -/
theorem cumulativeCode_eq_truncate (τ : ℕ → Q → γ) (d : γ) {s t : ℕ} (hst : s ≤ t) :
    cumulativeCode τ d s = truncateCode d s ∘ cumulativeCode τ d t := by
  funext q i
  by_cases h : i ≤ s
  · simp [cumulativeCode, truncateCode, h, h.trans hst]
  · simp [cumulativeCode, truncateCode, h]

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
The σ-algebras generated by the cumulative codes increase with the level. -/
theorem comap_cumulativeCode_monotone [MeasurableSpace γ] (τ : ℕ → Q → γ) (d : γ) :
    Monotone (fun s => MeasurableSpace.comap (cumulativeCode τ d s) inferInstance) := by
  intro s t hst
  simp only
  rw [cumulativeCode_eq_truncate τ d hst, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_truncateCode d s).comap_le

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
The whole code is measurable for the supremum of the cumulative-code σ-algebras. -/
theorem measurable_iSup_wholeCode [MeasurableSpace Q] [MeasurableSpace γ]
    {τ : ℕ → Q → γ} (d : γ) (_hτ : ∀ i, Measurable (τ i)) :
    Measurable[⨆ s, MeasurableSpace.comap (cumulativeCode τ d s) inferInstance]
      (fun q i => τ i q) := by
  let : MeasurableSpace Q := ⨆ s, MeasurableSpace.comap (cumulativeCode τ d s) inferInstance
  refine measurable_pi_iff.2 fun i => ?_
  have h1 : Measurable[MeasurableSpace.comap (cumulativeCode τ d i) inferInstance]
      (cumulativeCode τ d i) := comap_measurable _
  have h2 : Measurable[⨆ s, MeasurableSpace.comap (cumulativeCode τ d s) inferInstance]
      (cumulativeCode τ d i) := h1.mono (le_iSup (fun s =>
        MeasurableSpace.comap (cumulativeCode τ d s) inferInstance) i) le_rfl
  have h3 := (measurable_pi_apply (X := fun _ : ℕ => γ) i).comp h2
  simpa [Function.comp_def, cumulativeCode] using h3

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
The decoder reading a cumulative code off a measurable family `f`. -/
@[expose] def cumulativeDecoder (f : ℕ → C → γ) (d : γ) (s : ℕ) (h : C) : ℕ → γ :=
  fun i => if i ≤ s then f i h else d

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
`cumulativeDecoder` is measurable. -/
theorem measurable_cumulativeDecoder [MeasurableSpace C] [MeasurableSpace γ]
    {f : ℕ → C → γ} (d : γ) (hf : ∀ i, Measurable (f i))
    (s : ℕ) : Measurable (cumulativeDecoder f d s) := by
  refine measurable_pi_iff.2 fun i => ?_
  by_cases h : i ≤ s
  · simpa [cumulativeDecoder, h] using hf i
  · simp only [cumulativeDecoder, h, ite_false]
    exact measurable_const

/-- Helper toward Proposition 4.7 (prop-thin-ind); not a paper result.
If the truncations of index `≤ s` of `q` agree with `f i c`, the codes agree. -/
theorem cumulativeCode_eq_decoder (τ : ℕ → Q → γ) (f : ℕ → C → γ) (d : γ) (s : ℕ) (q : Q)
    (c : C) (h : ∀ i ≤ s, τ i q = f i c) :
    cumulativeCode τ d s q = cumulativeDecoder f d s c := by
  funext i
  by_cases hi : i ≤ s
  · simp [cumulativeCode, cumulativeDecoder, hi, h i hi]
  · simp [cumulativeCode, cumulativeDecoder, hi]

end DirectedDistances.PaperProofs.Section4
