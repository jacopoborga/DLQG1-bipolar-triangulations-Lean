module

public import DirectedDistances.PaperProofs.Section4.ThinSideCodeFidelity
public import Mathlib.MeasureTheory.MeasurableSpace.Constructions
public import Mathlib.MeasureTheory.Measure.MeasureSpaceDef

/-! # Measurable classes of marked geometric sides -/

public section
namespace DirectedDistances.PaperProofs.Section5

open MeasureTheory Filter DirectedDistances.PaperProofs.Section4
open scoped Classical

/-- Helper toward Lemma 5.5. The measurable code records all ten fields of a geometric side: vertex and edge
membership, west and east endpoint maps, presence, rotation, face succession, root,
and the indexed boundary and seam darts. -/
abbrev GeometricSideCode :=
  (ℕ → Bool) × (ℕ → Bool) × (ℕ → ℕ) × (ℕ → ℕ) × (ℕ → Bool) ×
    ((ℕ × Bool) → (ℕ × Bool) → Bool) × ((ℕ × Bool) → (ℕ × Bool) → Bool) ×
    ℕ × (ℕ → ℕ × Bool) × (ℕ → ℕ × Bool)

/-- Encode every field of a marked geometric side by countable coordinate data.
Helper toward Lemma 5.5. -/
@[expose] noncomputable def geometricSideCode (M : GeometricSideSubmap) : GeometricSideCode :=
  (fun n => decide (n ∈ M.vertices),
   fun n => decide (n ∈ M.edges),
   M.west,
   M.east,
   fun n => decide (n ∈ M.present),
   fun d e => decide (M.rotation d e),
   fun d e => decide (M.faceNext d e),
   M.root,
   M.boundary,
   M.seam)

private theorem prop_eq_of_decide_eq {P Q : Prop} [Decidable P] [Decidable Q]
    (h : decide P = decide Q) : P = Q := by
  by_cases hp : P <;> by_cases hq : Q <;> simp_all

/-- Helper toward Lemma 5.5. The side code is injective, so each geometric and marked field can be recovered. -/
theorem geometricSideCode_injective : Function.Injective geometricSideCode := by
  classical
  intro M N h
  cases M with
  | mk Mv Me Mw Mx Mp Mr Mf Mroot Mb Ms =>
    cases N with
    | mk Nv Ne Nw Nx Np Nr Nf Nroot Nb Ns =>
      simp only [geometricSideCode, Prod.mk.injEq] at h
      rcases h with ⟨hV, hE, hW, hX, hP, hR, hF, hRoot, hB, hS⟩
      have hV' : Mv = Nv := by
        apply Set.ext
        intro n
        exact Iff.of_eq (prop_eq_of_decide_eq (congrFun hV n))
      have hE' : Me = Ne := by
        apply Set.ext
        intro n
        exact Iff.of_eq (prop_eq_of_decide_eq (congrFun hE n))
      have hP' : Mp = Np := by
        apply Set.ext
        intro n
        exact Iff.of_eq (prop_eq_of_decide_eq (congrFun hP n))
      have hR' : Mr = Nr := by
        funext d e
        exact prop_eq_of_decide_eq (congrFun (congrFun hR d) e)
      have hF' : Mf = Nf := by
        funext d e
        exact prop_eq_of_decide_eq (congrFun (congrFun hF d) e)
      simp_all

/-- The measurable space on geometric sides is generated by the complete field code. -/
noncomputable instance : MeasurableSpace GeometricSideSubmap :=
  MeasurableSpace.comap geometricSideCode inferInstance

/-- Helper toward Lemma 5.5. Reflexive marked isomorphism. -/
@[expose] def GeometricSideMarkedIso.refl (M : GeometricSideSubmap) :
    GeometricSideMarkedIso M M where
  equiv := Equiv.refl _
  relation_iff := by intro t u v; rfl

/-- Helper toward Lemma 5.5. Reverse a marked isomorphism. -/
@[expose] def GeometricSideMarkedIso.symm {M N : GeometricSideSubmap}
    (I : GeometricSideMarkedIso M N) : GeometricSideMarkedIso N M where
  equiv := I.equiv.symm
  relation_iff := by
    intro t u v
    simpa using (I.relation_iff t (I.equiv.symm u) (I.equiv.symm v)).symm

/-- Helper toward Lemma 5.5. Compose marked isomorphisms. -/
@[expose] def GeometricSideMarkedIso.trans {M N P : GeometricSideSubmap}
    (I : GeometricSideMarkedIso M N) (J : GeometricSideMarkedIso N P) :
    GeometricSideMarkedIso M P where
  equiv := I.equiv.trans J.equiv
  relation_iff := by
    intro t u v
    exact (I.relation_iff t u v).trans (J.relation_iff t (I.equiv u) (I.equiv v))

/-- Helper toward Lemma 5.5. Marked isomorphism is an equivalence relation on geometric sides. -/
@[expose] def geometricSideSetoid : Setoid GeometricSideSubmap where
  r M N := Nonempty (GeometricSideMarkedIso M N)
  iseqv := ⟨
    fun M => ⟨GeometricSideMarkedIso.refl M⟩,
    fun h => h.elim fun I => ⟨GeometricSideMarkedIso.symm I⟩,
    fun h₁ h₂ => h₁.elim fun I => h₂.elim fun J =>
      ⟨GeometricSideMarkedIso.trans I J⟩⟩

/-- Helper toward Lemma 5.5. The quotient of geometric sides by marked isomorphism. -/
@[expose] def GeometricSideClass := Quotient geometricSideSetoid

/-- Helper toward Lemma 5.5. Send a geometric side to its marked-isomorphism class. -/
@[expose] def geometricSideClass (M : GeometricSideSubmap) : GeometricSideClass :=
  Quotient.mk geometricSideSetoid M

/-- Helper toward Lemma 5.5. Equality of classes is exactly existence of a marked isomorphism. -/
theorem geometricSideClass_eq_iff (M N : GeometricSideSubmap) :
    geometricSideClass M = geometricSideClass N ↔
      Nonempty (GeometricSideMarkedIso M N) := by
  constructor
  · exact Quotient.exact
  · intro h
    change Quotient.mk geometricSideSetoid M = Quotient.mk geometricSideSetoid N
    exact Quotient.sound h

/-- Helper toward Lemma 5.5. The quotient measurable space makes the class map measurable. -/
noncomputable instance : MeasurableSpace GeometricSideClass :=
  MeasurableSpace.map geometricSideClass inferInstance

/-- Helper toward Lemma 5.5. The geometric-side class map is measurable. -/
theorem measurable_geometricSideClass : Measurable geometricSideClass := by
  rw [measurable_iff_le_map]
  exact le_rfl

/-- Almost-sure marked isomorphism gives almost-sure equality of geometric-side classes.
Helper toward Lemma 5.5. -/
theorem geometricSideClass_ae_eq {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (X Y : Ω → GeometricSideSubmap)
    (h : ∀ᵐ ω ∂μ, Nonempty (GeometricSideMarkedIso (X ω) (Y ω))) :
    (fun ω => geometricSideClass (X ω)) =ᵐ[μ]
      (fun ω => geometricSideClass (Y ω)) := by
  filter_upwards [h] with ω hω
  exact Quotient.sound hω

/- for every `(x : XDP)` and `(k : ℤ)`, the classes of `rng M_{x_k,∞}^L` and
`rng M_{x_k,∞}^R` are independent; for every `(x : XDP)`, `(k : ℤ)`, and
`(hk : 0 ≤ k)`, the class of `rng M_{x_k,∞}^R` has the same law as that of
`rng M_{x_0,∞}^R`; for every `(x : XDP)`, `(k : ℤ)`, and `(hk : k ≤ 0)`,
the class of `rng M_{x_k,∞}^L` has the same law as that of `rng M_{x_0,∞}^L`. -/

end DirectedDistances.PaperProofs.Section5

