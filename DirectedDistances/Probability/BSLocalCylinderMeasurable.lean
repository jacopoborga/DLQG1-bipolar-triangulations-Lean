module

public import DirectedDistances.Probability.BSLocalCriterion

/-! Measurability consequences for the local cylinder topology, as helpers toward
Proposition 5.16 (`prop-disk-bs-conv`). -/

public section
namespace DirectedDistances.Probability

open Set TopologicalSpace

variable {X : Type*} {C : ℕ → Type*} (b : ∀ r, X → C r)

/-- Helper toward Proposition 5.16 (`prop-disk-bs-conv`): the Borel sigma
algebra of the local class topology is generated by its radius cylinders. -/
theorem borel_localClassTopology_eq_generateFrom [∀ r, Countable (C r)]
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    (letI := localClassTopology b; borel X) =
      MeasurableSpace.generateFrom (localCylinders b) := by
  letI : TopologicalSpace X := localClassTopology b
  letI : SecondCountableTopology X := secondCountable_localClassTopology b
  exact (isTopologicalBasis_localCylinders b hcompat).borel_eq_generateFrom

/-- Helper toward Proposition 5.16 (`prop-disk-bs-conv`): measurability into
the local class Borel space is equivalent to measurability of every cylinder
fiber. -/
theorem measurable_to_localClass_iff [∀ r, Countable (C r)]
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y)
    {Ω : Type*} [MeasurableSpace Ω] (g : Ω → X) :
    (letI := localClassTopology b; letI := borel X; Measurable g) ↔
      ∀ r (c : C r), MeasurableSet (g ⁻¹' (b r ⁻¹' {c})) := by
  letI : TopologicalSpace X := localClassTopology b
  letI : SecondCountableTopology X := secondCountable_localClassTopology b
  letI : MeasurableSpace X := borel X
  letI : BorelSpace X := ⟨rfl⟩
  constructor
  · intro hg r c
    exact hg (isClopen_localCylinder b r c).isOpen.measurableSet
  · intro hg
    rw [borel_localClassTopology_eq_generateFrom b hcompat]
    apply measurable_generateFrom
    intro s hs
    rcases hs with ⟨r, c, rfl⟩
    exact hg r c

/-- Helper toward Proposition 5.16 (`prop-disk-bs-conv`): a measurable map
whose radius observations factor through measurable-fiber maps is measurable
for the local class Borel space. -/
theorem measurable_of_localClass_comp_eq [∀ r, Countable (C r)]
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y)
    {Ω Y : Type*} [MeasurableSpace Ω] [MeasurableSpace Y]
    (g : Ω → X) (h : Ω → Y) (c : ∀ r, Y → C r)
    (hmeas : Measurable h)
    (hfib : ∀ r a, MeasurableSet (c r ⁻¹' {a}))
    (heq : ∀ r, b r ∘ g = c r ∘ h) :
    (letI := localClassTopology b; letI := borel X; Measurable g) := by
  apply (measurable_to_localClass_iff b hcompat g).2
  intro r a
  change MeasurableSet ((b r ∘ g) ⁻¹' {a})
  rw [heq r]
  change MeasurableSet (h ⁻¹' (c r ⁻¹' {a}))
  exact hmeas (hfib r a)

end DirectedDistances.Probability

