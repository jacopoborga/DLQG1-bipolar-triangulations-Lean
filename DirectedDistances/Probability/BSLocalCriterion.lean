module

public import Mathlib.MeasureTheory.Measure.Portmanteau
public import Mathlib.Topology.Bases

/-! Helper toward Proposition 5.16 (`prop-disk-bs-conv`) and Definition 3.8
criterion for local convergence in law; not a paper result. -/

public section
namespace DirectedDistances.Probability
open Set Filter TopologicalSpace MeasureTheory
open scoped Topology ENNReal NNReal

variable {X : Type*} {C : ℕ → Type*} (b : ∀ r, X → C r)

/-- Fixed-radius class cylinders; helper toward `prop-disk-bs-conv` and -/
@[expose] def localCylinders : Set (Set X) :=
  {s | ∃ r c, s = b r ⁻¹' {c}}

/-- The topology generated by fixed-radius classes; helper toward `prop-disk-bs-conv` -/
@[expose, instance_reducible] def localClassTopology : TopologicalSpace X :=
  TopologicalSpace.generateFrom (localCylinders b)

/-- Compatibility iterates to every smaller radius; helper toward `prop-disk-bs-conv` -/
theorem localClass_eq_of_le
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y)
    {r s : ℕ} (hrs : r ≤ s) {x y : X} (h : b s x = b s y) :
    b r x = b r y := by
  induction hrs with
  | refl => exact h
  | @step s hrs ih => exact ih (hcompat s x y h)

/-- Every cylinder is open; helper toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem isOpen_localCylinder (r : ℕ) (c : C r) :
    let := localClassTopology b
    IsOpen (b r ⁻¹' {c}) := by
  exact TopologicalSpace.GenerateOpen.basic _ ⟨r, c, rfl⟩

/-- A nonempty intersection is the finer centered cylinder; helper toward
not a paper result. -/
theorem localCylinder_inter
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y)
    (r s : ℕ) (x : X) :
    (b r ⁻¹' {b r x}) ∩ (b s ⁻¹' {b s x}) =
      b (max r s) ⁻¹' {b (max r s) x} := by
  ext y
  simp only [mem_inter_iff, mem_preimage, mem_singleton_iff]
  constructor
  · intro h
    rcases le_total r s with hrs | hsr
    · rw [max_eq_right hrs]
      exact h.2
    · rw [max_eq_left hsr]
      exact h.1
  · intro h
    exact ⟨localClass_eq_of_le b hcompat (le_max_left r s) h,
      localClass_eq_of_le b hcompat (le_max_right r s) h⟩

/-- Cylinders form a basis; helper toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem isTopologicalBasis_localCylinders
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    let := localClassTopology b
    IsTopologicalBasis (localCylinders b) := by
  let := localClassTopology b
  refine ⟨?_, ?_, rfl⟩
  · rintro _ ⟨r, c, rfl⟩ _ ⟨s, d, rfl⟩ x ⟨hx, hy⟩
    have hx' : b r x = c := hx
    have hy' : b s x = d := hy
    refine ⟨b (max r s) ⁻¹' {b (max r s) x}, ⟨max r s, _, rfl⟩, rfl, ?_⟩
    rw [← localCylinder_inter b hcompat, hx', hy']
  · exact eq_univ_of_forall fun x => ⟨b 0 ⁻¹' {b 0 x}, ⟨0, _, rfl⟩, rfl⟩

/-- Cylinders form a π-system; helper toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem isPiSystem_localCylinders
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    IsPiSystem (localCylinders b) := by
  rintro _ ⟨r, c, rfl⟩ _ ⟨s, d, rfl⟩ ⟨x, hx, hy⟩
  have hx' : b r x = c := hx
  have hy' : b s x = d := hy
  refine ⟨max r s, b (max r s) x, ?_⟩
  rw [← localCylinder_inter b hcompat, hx', hy']

/-- Cylinders are clopen; helper toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem isClopen_localCylinder (r : ℕ) (c : C r) :
    let := localClassTopology b
    IsClopen (b r ⁻¹' {c}) := by
  let := localClassTopology b
  refine ⟨?_, isOpen_localCylinder b r c⟩
  apply isOpen_compl_iff.mp
  have heq : (b r ⁻¹' {c})ᶜ = ⋃ d : {d : C r // d ≠ c}, b r ⁻¹' {d.val} := by
    ext x
    simp only [mem_compl_iff, mem_preimage, mem_singleton_iff, mem_iUnion]
    exact ⟨fun h => ⟨⟨b r x, h⟩, rfl⟩, fun ⟨d, hd⟩ => hd ▸ d.property⟩
  rw [heq]
  exact isOpen_iUnion fun d => isOpen_localCylinder b r d.val

/-- Countability of the cylinder family; helper toward `prop-disk-bs-conv` and -/
theorem countable_localCylinders [∀ r, Countable (C r)] :
    (localCylinders b).Countable := by
  have heq : localCylinders b = range (fun p : Sigma C => b p.1 ⁻¹' {p.2}) := by
    ext s
    simp only [localCylinders, mem_ofPred_eq, mem_range]
    exact ⟨fun ⟨r, c, h⟩ => ⟨⟨r, c⟩, h.symm⟩,
      fun ⟨⟨r, c⟩, h⟩ => ⟨r, c, h.symm⟩⟩
  rw [heq]
  exact countable_range _

/-- The cylinder topology is second countable; helper toward `prop-disk-bs-conv` -/
theorem secondCountable_localClassTopology [∀ r, Countable (C r)] :
    @SecondCountableTopology X (localClassTopology b) :=
  SecondCountableTopology.mk' (countable_localCylinders b)

/-- The Borel sigma algebra is generated by cylinders; helper toward
not a paper result. -/
theorem borel_localClassTopology [∀ r, Countable (C r)] :
    let := localClassTopology b
    borel X = MeasurableSpace.generateFrom (localCylinders b) := by
  let := localClassTopology b
  let := secondCountable_localClassTopology b
  exact borel_eq_generateFrom_of_subbasis rfl

/-- Radius-class maps to discrete spaces are continuous; helper toward
not a paper result. -/
theorem continuous_localClass [∀ r, TopologicalSpace (C r)]
    [∀ r, DiscreteTopology (C r)] (r : ℕ) :
    letI := localClassTopology b
    Continuous (b r) := by
  let := localClassTopology b
  exact continuous_discrete_rng.mpr (isOpen_localCylinder b r)

private theorem tendsto_probabilityMeasure_clopen
    {Y : Type*} [TopologicalSpace Y] [MeasurableSpace Y] [OpensMeasurableSpace Y]
    {ι : Type*} {L : Filter ι} {μs : ι → ProbabilityMeasure Y} {μ : ProbabilityMeasure Y}
    (hμ : Tendsto μs L (𝓝 μ)) {s : Set Y} (hs : IsClopen s) :
    Tendsto (fun i => μs i s) L (𝓝 (μ s)) := by
  have h := ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hμ
    (BoundedContinuousFunction.indicator s hs)
  change Tendsto (fun i => ∫ x, s.indicator 1 x ∂(μs i : Measure Y)) L
    (𝓝 (∫ x, s.indicator 1 x ∂(μ : Measure Y))) at h
  simp only [integral_indicator_one hs.isOpen.measurableSet, Measure.real,
    ← ProbabilityMeasure.ennreal_coeFn_eq_coeFn_toMeasure, ENNReal.coe_toReal] at h
  exact NNReal.tendsto_coe.mp h

/-- Weak convergence implies cylinder-mass convergence; helper toward
not a paper result. -/
theorem tendsto_localCylinder_of_tendsto :
    letI := localClassTopology b
    letI := borel X
    letI : BorelSpace X := ⟨rfl⟩
    ∀ {ι : Type*} {L : Filter ι} {μs : ι → ProbabilityMeasure X}
      {μ : ProbabilityMeasure X}, Tendsto μs L (𝓝 μ) →
      ∀ r c, Tendsto (fun i => μs i (b r ⁻¹' {c})) L (𝓝 (μ (b r ⁻¹' {c}))) := by
  let := localClassTopology b
  let := borel X
  let : BorelSpace X := ⟨rfl⟩
  intro ι L μs μ hμ r c
  exact tendsto_probabilityMeasure_clopen hμ (isClopen_localCylinder b r c)

/-- Cylinder-mass convergence implies weak convergence; helper toward
not a paper result. -/
theorem tendsto_of_localCylinder [∀ r, Countable (C r)]
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    letI := localClassTopology b
    letI := borel X
    letI : BorelSpace X := ⟨rfl⟩
    ∀ {ι : Type*} {L : Filter ι} [L.IsCountablyGenerated]
      {μs : ι → ProbabilityMeasure X} {μ : ProbabilityMeasure X},
      (∀ r c, Tendsto (fun i => μs i (b r ⁻¹' {c})) L
        (𝓝 (μ (b r ⁻¹' {c})))) → Tendsto μs L (𝓝 μ) := by
  let := localClassTopology b
  let := borel X
  let : BorelSpace X := ⟨rfl⟩
  let := secondCountable_localClassTopology b
  intro ι L hL μs μ hμ
  have hb := isTopologicalBasis_localCylinders b hcompat
  apply (isPiSystem_localCylinders b hcompat).tendsto_probabilityMeasure_of_tendsto_of_mem
  · intro s hs
    exact (hb.isOpen hs).measurableSet
  · intro u hu x hx
    obtain ⟨s, hs, hxs, hsu⟩ := hb.exists_subset_of_mem_open hx hu
    exact ⟨s, hs, hb.mem_nhds hs hxs, hsu⟩
  · rintro s ⟨r, c, rfl⟩
    exact hμ r c

/-- The abstract two-way local-law criterion; helper toward `prop-disk-bs-conv` -/
theorem tendsto_iff_localCylinder [∀ r, Countable (C r)]
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    letI := localClassTopology b
    letI := borel X
    letI : BorelSpace X := ⟨rfl⟩
    ∀ {ι : Type*} {L : Filter ι} [L.IsCountablyGenerated]
      {μs : ι → ProbabilityMeasure X} {μ : ProbabilityMeasure X},
      Tendsto μs L (𝓝 μ) ↔
        ∀ r c, Tendsto (fun i => μs i (b r ⁻¹' {c})) L
          (𝓝 (μ (b r ⁻¹' {c}))) := by
  let := localClassTopology b
  let := borel X
  let : BorelSpace X := ⟨rfl⟩
  intro ι L hL μs μ
  exact ⟨tendsto_localCylinder_of_tendsto b, tendsto_of_localCylinder b hcompat⟩

/-- The literal infimum distance from `def-bs-topology`, with extended values so
that no agreement at radius zero gives infinity. Helper toward `prop-disk-bs-conv` -/
@[expose] noncomputable def localClassEDist (x y : X) : ℝ≥0∞ :=
  ⨅ r, ⨅ (_ : b r x = b r y), (2 : ℝ≥0∞)⁻¹ ^ r

/-- Strict balls for the literal infimum use successor-radius agreement. Helper
 toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem localClassEDist_lt_pow_iff
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y)
    (r : ℕ) (x y : X) :
    localClassEDist b x y < (2 : ℝ≥0∞)⁻¹ ^ r ↔ b (r + 1) x = b (r + 1) y := by
  have hpow (m n : ℕ) :
      (2 : ℝ≥0∞)⁻¹ ^ m < (2 : ℝ≥0∞)⁻¹ ^ n ↔ n < m := by
    rw [← ENNReal.coe_inv_two, ← ENNReal.coe_pow, ← ENNReal.coe_pow,
      ENNReal.coe_lt_coe]
    exact pow_lt_pow_iff_right_of_lt_one₀ (by norm_num) (by norm_num)
  simp only [localClassEDist, iInf_lt_iff]
  constructor
  · rintro ⟨s, hs, hsr⟩
    have hrs : r < s := (hpow s r).mp hsr
    exact localClass_eq_of_le b hcompat (Nat.succ_le_of_lt hrs) hs
  · intro h
    exact ⟨r + 1, h, (hpow (r + 1) r).mpr (Nat.lt_succ_self r)⟩

/-- An arbitrary strict distance ball is a union of cylinders. Helper toward
not a paper result. -/
theorem localClassEDist_ball_eq (x : X) (ε : ℝ≥0∞) :
    {y | localClassEDist b x y < ε} =
      ⋃ r : {r : ℕ // (2 : ℝ≥0∞)⁻¹ ^ r < ε}, b r.val ⁻¹' {b r.val x} := by
  ext y
  simp only [mem_ofPred_eq, localClassEDist, iInf_lt_iff, mem_iUnion, mem_preimage,
    mem_singleton_iff]
  exact ⟨fun ⟨r, h, hr⟩ => ⟨⟨r, hr⟩, h.symm⟩,
    fun ⟨r, h⟩ => ⟨r.val, h.symm, r.property⟩⟩

/-- Every strict distance ball is open in the cylinder topology. Helper toward
not a paper result. -/
theorem isOpen_localClassEDist_ball (x : X) (ε : ℝ≥0∞) :
    letI := localClassTopology b
    IsOpen {y | localClassEDist b x y < ε} := by
  let := localClassTopology b
  rw [localClassEDist_ball_eq]
  exact isOpen_iUnion fun r => isOpen_localCylinder b r.val (b r.val x)

private theorem localClassEDist_lt_two_iff
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y)
    (x y : X) : localClassEDist b x y < 2 ↔ b 0 x = b 0 y := by
  simp only [localClassEDist, iInf_lt_iff]
  constructor
  · rintro ⟨r, hr, _⟩
    exact localClass_eq_of_le b hcompat (Nat.zero_le r) hr
  · intro h
    exact ⟨0, h, by norm_num⟩

/-- Every centered cylinder is a strict distance ball, including radius zero.
Helper toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem localCylinder_eq_EDist_ball
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y)
    (r : ℕ) (x : X) :
    b r ⁻¹' {b r x} = {y | localClassEDist b x y <
      match r with | 0 => 2 | n + 1 => (2 : ℝ≥0∞)⁻¹ ^ n} := by
  cases r with
  | zero =>
    ext y
    simpa only [mem_preimage, mem_singleton_iff, mem_ofPred_eq, eq_comm]
      using (localClassEDist_lt_two_iff b hcompat x y).symm
  | succ r =>
    ext y
    simpa only [mem_preimage, mem_singleton_iff, mem_ofPred_eq, eq_comm]
      using (localClassEDist_lt_pow_iff b hcompat r x y).symm

/-- The literal distance balls generate exactly the cylinder topology. Helper
 toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem localClassTopology_eq_EDist_balls
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    localClassTopology b = TopologicalSpace.generateFrom
      {s | ∃ x ε, s = {y | localClassEDist b x y < ε}} := by
  apply le_antisymm
  · let := localClassTopology b
    apply le_generateFrom
    rintro s ⟨x, ε, rfl⟩
    exact isOpen_localClassEDist_ball b x ε
  · let : TopologicalSpace X := TopologicalSpace.generateFrom
      {s | ∃ x ε, s = {y | localClassEDist b x y < ε}}
    apply le_generateFrom
    rintro s ⟨r, c, rfl⟩
    rcases eq_empty_or_nonempty (b r ⁻¹' {c}) with h | ⟨x, hx⟩
    · rw [h]
      exact isOpen_empty
    · have hx' : b r x = c := hx
      rw [← hx', localCylinder_eq_EDist_ball b hcompat]
      exact TopologicalSpace.GenerateOpen.basic _ ⟨x, _, rfl⟩

/-- The criterion expressed as convergence of every fixed-radius push-forward law.
Helper toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem tendsto_iff_localClass_map [∀ r, Countable (C r)]
    [∀ r, MeasurableSpace (C r)] [∀ r, MeasurableSingletonClass (C r)]
    [∀ r, TopologicalSpace (C r)] [∀ r, DiscreteTopology (C r)]
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    letI := localClassTopology b
    letI := borel X
    letI : BorelSpace X := ⟨rfl⟩
    ∀ {ι : Type*} {L : Filter ι} [L.IsCountablyGenerated]
      {μs : ι → ProbabilityMeasure X} {μ : ProbabilityMeasure X},
      Tendsto μs L (𝓝 μ) ↔
        ∀ r, Tendsto (fun i => (μs i).map (b r)) L (𝓝 (μ.map (b r))) := by
  let := localClassTopology b
  let := borel X
  let : BorelSpace X := ⟨rfl⟩
  intro ι L hL μs μ
  constructor
  · intro h r
    exact ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous μs μ h
      (continuous_localClass b r)
  · intro h
    apply tendsto_of_localCylinder b hcompat
    intro r c
    have hc : IsClopen ({c} : Set (C r)) :=
      ⟨isClosed_discrete _, isOpen_discrete _⟩
    have hm := (continuous_localClass b r).measurable
    have ht := tendsto_probabilityMeasure_clopen (h r) hc
    simpa only [ProbabilityMeasure.map_apply _ hm.aemeasurable (measurableSet_singleton c)]
      using ht

/-- Adjoining the empty and universal sets gives closure under all finite
intersections. Helper toward `prop-disk-bs-conv` and `def-bs-topology` -/
theorem finiteInter_localCylinders
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    FiniteInter (insert ∅ (insert univ (localCylinders b))) := by
  refine ⟨by simp only [mem_insert_iff, true_or, or_true], ?_⟩
  intro s hs t ht
  rcases eq_empty_or_nonempty (s ∩ t) with h | h
  · rw [h]
    exact mem_insert _ _
  · exact (isPiSystem_localCylinders b hcompat).insert_univ.insert_empty s hs t ht h

/-- The finite-intersection-closed cylinder family is still a basis. Helper toward
not a paper result. -/
theorem isTopologicalBasis_localCylinders_insert
    (hcompat : ∀ r x y, b (r + 1) x = b (r + 1) y → b r x = b r y) :
    letI := localClassTopology b
    IsTopologicalBasis (insert ∅ (insert univ (localCylinders b))) := by
  let := localClassTopology b
  have hb := isTopologicalBasis_localCylinders b hcompat
  apply hb.of_isOpen_of_subset
  · intro s hs
    rcases hs with rfl | hs
    · exact isOpen_empty
    rcases hs with rfl | hs
    · exact isOpen_univ
    · exact hb.isOpen hs
  · exact fun s hs => mem_insert_of_mem _ (mem_insert_of_mem _ hs)

private theorem uniform_probabilityMeasure_discrete
    {Y : Type*} [Countable Y] [TopologicalSpace Y] [DiscreteTopology Y]
    [MeasurableSpace Y] [MeasurableSingletonClass Y]
    {ι : Type*} {L : Filter ι} {μs : ι → ProbabilityMeasure Y} {μ : ProbabilityMeasure Y}
    (hμ : Tendsto μs L (𝓝 μ)) (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ i in L, ∀ A : Set Y, |(μs i A : ℝ) - (μ A : ℝ)| < ε := by
  classical
  let δ : ℝ := min (ε / 3) (1 / 2)
  have hδ : 0 < δ := lt_min (by linarith) (by norm_num)
  have hδ1 : δ < 1 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  have hδε : 2 * δ < ε := by
    have := min_le_left (ε / 3) (1 / 2 : ℝ)
    change δ ≤ ε / 3 at this
    linarith
  let q : ℝ≥0 := ⟨1 - δ, by linarith⟩
  have hq : q < μ univ := by
    rw [ProbabilityMeasure.coeFn_univ]
    change (⟨1 - δ, _⟩ : ℝ≥0) < 1
    exact_mod_cast (show 1 - δ < 1 by linarith)
  obtain ⟨T, hT, hmass, _⟩ := μ.exists_lt_measure_biUnion_of_isOpen
    (S := {s : Set Y | s.Finite})
    (fun u _ x hx => ⟨{x}, finite_singleton x,
      (isOpen_discrete _).mem_nhds (mem_singleton x), singleton_subset_iff.mpr hx⟩)
    isOpen_univ hq
  let K : Set Y := ⋃ s ∈ T, s
  have hK : K.Finite := T.finite_toSet.biUnion fun s hs => hT s hs
  have hmass' : 1 - δ < (μ K : ℝ) := by exact_mod_cast hmass
  have hc (p : ProbabilityMeasure Y) (A : Set Y) :
      (p A : ℝ) + (p Aᶜ : ℝ) = 1 := by
    simpa only [ProbabilityMeasure.measureReal_eq_coe_coeFn, probReal_univ] using
      (measureReal_add_measureReal_compl (μ := (p : Measure Y))
        A.to_countable.measurableSet)
  have htail : (μ Kᶜ : ℝ) < δ := by linarith [hc μ K]
  have hevent : ∀ᶠ i in L, ∀ A ⊆ K, (μ A : ℝ) < (μs i A : ℝ) + δ := by
    apply hK.finite_subsets.eventually_all.mpr
    intro A _
    have ht := NNReal.tendsto_coe.mpr
      (tendsto_probabilityMeasure_clopen hμ
        (show IsClopen A from ⟨isClosed_discrete _, isOpen_discrete _⟩))
    filter_upwards [(tendsto_order.mp ht).1 ((μ A : ℝ) - δ) (by linarith)] with i hi
    linarith
  filter_upwards [hevent] with i hi
  have hbound (A : Set Y) : (μ A : ℝ) < (μs i A : ℝ) + 2 * δ := by
    have hcover : A ⊆ (A ∩ K) ∪ Kᶜ := by
      intro x hx
      by_cases h : x ∈ K
      · exact Or.inl ⟨hx, h⟩
      · exact Or.inr h
    have hm : (μ A : ℝ) ≤ (μ (A ∩ K) : ℝ) + (μ Kᶜ : ℝ) := by
      exact_mod_cast (μ.apply_mono hcover).trans (μ.apply_union_le)
    have hn : (μs i (A ∩ K) : ℝ) ≤ (μs i A : ℝ) := by
      exact_mod_cast (μs i).apply_mono inter_subset_left
    have hj := hi (A ∩ K) inter_subset_right
    linarith
  intro A
  apply abs_lt.mpr
  constructor
  · linarith [hbound A]
  · linarith [hbound Aᶜ, hc μ A, hc (μs i) A]

/-- At each radius the convergence is uniform over all class events, the
 total-variation criterion on a countable discrete space. Helper toward
not a paper result. -/
theorem tendsto_localClass_uniform [∀ r, Countable (C r)]
    [∀ r, MeasurableSpace (C r)] [∀ r, MeasurableSingletonClass (C r)]
    [∀ r, TopologicalSpace (C r)] [∀ r, DiscreteTopology (C r)] :
    letI := localClassTopology b
    letI := borel X
    letI : BorelSpace X := ⟨rfl⟩
    ∀ {ι : Type*} {L : Filter ι} {μs : ι → ProbabilityMeasure X}
      {μ : ProbabilityMeasure X}, Tendsto μs L (𝓝 μ) →
      ∀ r (ε : ℝ), 0 < ε → ∀ᶠ i in L, ∀ A : Set (C r),
        |((μs i).map (b r) A : ℝ) - (μ.map (b r) A : ℝ)| < ε := by
  let := localClassTopology b
  let := borel X
  let : BorelSpace X := ⟨rfl⟩
  intro ι L μs μ hμ r ε hε
  exact uniform_probabilityMeasure_discrete
    (ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous μs μ hμ
      (continuous_localClass b r)) ε hε

end DirectedDistances.Probability
